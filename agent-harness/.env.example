# Copy this file to .env and fill in your keys. .env is ignored by git.
#
# The names say OPENROUTER but the provider is chosen by BASE_URL: the code
# uses the openai SDK, which talks to any OpenAI-compatible endpoint.
#
# Anthropic direct:
#   OPENROUTER_BASE_URL=https://api.anthropic.com/v1/
#   OPENROUTER_MODEL=claude-haiku-4-5
# OpenRouter:
#   OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#   OPENROUTER_MODEL=anthropic/claude-haiku-4.5

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=
