# Copy this file to .env and fill in your key. .env is ignored by git.
#
# The variable names say OPENROUTER, but the provider is chosen by BASE_URL:
# the code drives the openai SDK, which talks to any OpenAI-compatible endpoint.
# Only the URL and the model name change.
#
# The model must support tool calling — without it the loop has nothing to do.
#
# OpenAI
#   OPENROUTER_BASE_URL=https://api.openai.com/v1
#   OPENROUTER_MODEL=gpt-4o-mini        cheapest that still calls tools reliably
#   OPENROUTER_MODEL=gpt-4.1-mini       a step up, still cheap
#
# Anthropic direct
#   OPENROUTER_BASE_URL=https://api.anthropic.com/v1/
#   OPENROUTER_MODEL=claude-haiku-4-5
#
# OpenRouter
#   OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#   OPENROUTER_MODEL=anthropic/claude-haiku-4.5

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=
