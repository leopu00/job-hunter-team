; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Job Hunter Team"
config/description="Prototipo gamificato di Job Hunter Team: cammina nella box di vetro dove i tuoi agenti AI cercano lavoro per te."
run/main_scene="res://scenes/title.tscn"
run/max_fps=60
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.0235294, 0.0235294, 0.0313726, 1)
boot_splash/show_image=false
config/icon="res://assets/icon.svg"

[autoload]

Log="*res://scripts/log.gd"
Game="*res://scripts/game.gd"
TeamData="*res://scripts/data/team_data.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[importer_defaults]

texture={
"svg/scale": 2.0
}

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.0235294, 0.0235294, 0.0313726, 1)
