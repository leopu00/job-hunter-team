; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Job Hunter Team"
config/description="Applicazione desktop nativa di Job Hunter Team: configura e osserva i tuoi agenti AI nel loro ufficio."
config/version="0.3.3"
run/main_scene="res://scenes/title.tscn"
run/max_fps=60
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.0235294, 0.0235294, 0.0313726, 1)
boot_splash/show_image=false
config/icon="res://assets/icon.png"

[autoload]

Log="*res://scripts/log.gd"
Game="*res://scripts/game.gd"
TeamData="*res://scripts/data/team_data.gd"
BackendBus="*res://scripts/backend/backend_bus.gd"
SetupService="*res://scripts/setup/setup_service.gd"
ScriptedOnboarding="*res://scripts/setup/scripted_onboarding.gd"
TourGuide="*res://scripts/setup/tour_guide.gd"
FeedbackService="*res://scripts/support/feedback_service.gd"
UpdateService="*res://scripts/support/update_service.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1
; Su Linux il default parte in X11: dentro una sessione Wayland finisce su
; Xwayland, che in questa configurazione non ha accesso alla GPU e rasterizza
; a CPU — 254% di CPU e 2 fps sul ThinkPad, contro 21% e 45 fps col backend
; nativo (misurato 24/07). Se il compositore Wayland non c'è, Godot ricade
; su X11 da solo.
display_server/driver.linuxbsd="wayland"

[importer_defaults]

texture={
"svg/scale": 2.0
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.0235294, 0.0235294, 0.0313726, 1)
