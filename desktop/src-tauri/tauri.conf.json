{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Job Hunter Team",
  "version": "0.1.0",
  "identifier": "ai.jobhunterteam.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Job Hunter Team",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self' http://127.0.0.1:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' http://127.0.0.1:1420; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../api-worker/.dockerignore": "runtime/api-worker/.dockerignore",
      "../../api-worker/Dockerfile": "runtime/api-worker/Dockerfile",
      "../../api-worker/fixtures/": "runtime/api-worker/fixtures/",
      "../../api-worker/package-lock.json": "runtime/api-worker/package-lock.json",
      "../../api-worker/package.json": "runtime/api-worker/package.json",
      "../../api-worker/src/": "runtime/api-worker/src/",
      "../../api-worker/tsconfig.json": "runtime/api-worker/tsconfig.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128-2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
