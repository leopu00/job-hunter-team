# ============================================================
# .env.example — job-hunter-team
# Copy to .env and fill in your values. Never commit .env.
#
# NOTHING in this file is required to run JHT. The team
# authenticates through a *subscription* CLI login
# (`jht oauth-login`), not through API keys — see
# docs/adr/0004-subscription-only-no-api-keys.md. Every key
# below is either an escape hatch or an optional integration:
# leave the whole file untouched and the team still starts.
# ============================================================

# ── PATH JHT ────────────────────────────────────────────────
# I path sono fissi: ~/.jht (nascosto, agenti/db/config) e
# ~/Documents/Job Hunter Team (visibile, CV e output utente).
# Le env var qui sotto servono solo per test/CI per isolare
# i test dai dati reali dell'utente. Non serve impostarle in
# produzione.
# JHT_HOME=~/.jht
# JHT_USER_DIR=~/Documents/Job Hunter Team

# ── CONTAINER RUNTIME (letti da docker-compose.yml) ─────────
# Normalmente li scrive il setup wizard in ~/.jht/host.env; qui
# sono elencati perche' docker-compose.yml li espande da .env se
# ci sono. I default fra {} valgono quando la variabile manca.

# Tipo di host, letto dal dispatcher pid1: vuoto/`local` per PC
# locale, `vps` per una VPS (lo setta host-setup.sh). {vuoto}
# JHT_HOST_TYPE=

# Lingua scelta al primo run del wizard (en|it). {en}
# JHT_LANG=en

# Timezone utente in formato IANA (es. Europe/Rome, Asia/Shanghai).
# Usata per i timestamp nei messaggi Telegram e nei grafici. {UTC}
# JHT_USER_TZ=UTC

# Immagine del container. Override utile per provare l'immagine di
# un branch dev prima del merge a master.
# {ghcr.io/leopu00/jht:latest}
# JHT_IMAGE=ghcr.io/leopu00/jht:dev-1

# NB: nonostante il prefisso NEXT_PUBLIC_, queste NON servono a
# Next (che nel container non gira): le legge il sync del container
# (shared/skills/db_to_supabase.py, `jht doctor`) come fallback
# quando la config non arriva da ~/.jht/cloud.json.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Deploy-mode deciso a build/deploy: il container e' sempre
# co-locato col team, quindi `local` (SQLite source-of-truth,
# scrittura piena). Solo il deploy Vercel usa `cloud`. {local}
# NEXT_PUBLIC_JHT_DEPLOY=local

# ── OPTIONAL — LLM PROVIDER ─────────────────────────────────
# Il percorso normale e' il login a sottoscrizione: `jht oauth-login`
# apre il flusso del provider attivo (Claude TUI, Codex device code,
# Kimi TUI) e la sessione viene riusata da tutti gli agenti.
# Le API key qui sotto sono un *escape hatch* per usi scriptati /
# server-side: non sono il default e non servono per usare il
# prodotto. Attenzione, sono anche pay-per-use — con i volumi del
# team (~400M token/mese) il conto e' di ordini di grandezza
# superiore all'abbonamento (ADR-0004).

# Provider LLM di default (claude, openai, kimi). {claude}
# JHT_LLM_PROVIDER=claude

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# MOONSHOT_API_KEY=

# ── OPTIONAL — NOTIFICATIONS ────────────────────────────────

# Telegram bot token — get from @BotFather
# Leave empty to disable Telegram notifications
TELEGRAM_BOT_TOKEN=

# Your Telegram chat ID — send /start to your bot to get it
TELEGRAM_CHAT_ID=

# ── OPTIONAL — EMAIL MONITORING ─────────────────────────────
# La casella dedicata del team (skill email-monitor) NON si
# configura da qui: credenziali e host IMAP si inseriscono
# dall'app, che li salva fuori dal repo. Se la casella non e'
# configurata il team fa solo web sourcing.

# ── OPTIONAL — LINKEDIN ──────────────────────────────────────

# Path to Chrome persistent profile for authenticated LinkedIn checks
# Leave empty to skip LinkedIn verification
# LINKEDIN_PROFILE_PATH=

# ── OPTIONAL — DATABASE ─────────────────────────────────────

# Leave empty to use SQLite (default, local-first)
# Set to a PostgreSQL URL for multi-user deployments
# DATABASE_URL=postgresql://user:password@localhost:5432/jobhunter

# ── OPTIONAL — GOOGLE SHEETS ────────────────────────────────

# Google Sheets ID for exporting the dashboard
# Leave empty to disable
GOOGLE_SHEETS_ID=

# ── OPTIONAL — GOOGLE DRIVE ─────────────────────────────────

# Google Drive folder ID for uploading CV/CL PDFs
# Create a folder in your Drive, copy the ID from the URL
# Leave empty to disable Drive upload
JH_DRIVE_FOLDER_ID=

# Path to Google service account JSON (for Sheets integration)
# Download from: https://console.cloud.google.com/iam-admin/serviceaccounts
# Save in shared/secrets/google-service-account.json
# GOOGLE_SERVICE_ACCOUNT_PATH=./shared/secrets/google-service-account.json

# ── OPTIONAL — SUPABASE (per sync SQLite → Supabase) ─────────

# Supabase URL e service role key (necessari per db_to_supabase.py e db_to_sheets.py)
# Trovabili in Supabase Dashboard → Settings → API
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# UUID dell'utente Supabase a cui associare i dati sincronizzati
# Se omesso, usa il primo utente trovato in candidate_profiles
# JHT_SUPABASE_USER_ID=

# ── ROTATION GUIDE ───────────────────────────────────────────
#
# Vale per le credenziali che hai effettivamente impostato: non
# scadono da sole, vanno ruotate periodicamente (raccomandato:
# ogni 90 giorni o subito dopo qualsiasi sospetto di leak). Per
# ogni provider, link diretto al pannello dove si rigenera la
# chiave senza dover creare un nuovo account:
#
# - Anthropic (ANTHROPIC_API_KEY):
#     https://console.anthropic.com/settings/keys
#     "Create Key" → revoca la vecchia DOPO aver aggiornato .env
#
# - OpenAI (OPENAI_API_KEY):
#     https://platform.openai.com/api-keys
#     "Create new secret key" → poi disattiva la vecchia
#
# - Kimi (MOONSHOT_API_KEY):
#     https://www.kimi.chat/user-center/basic-information
#     Sezione "Interface Key" → genera nuova, revoca vecchia
#
# - Telegram (TELEGRAM_BOT_TOKEN):
#     scrivi /revoke a @BotFather → il bot ottiene un token nuovo
#
# - Google service account (GOOGLE_SERVICE_ACCOUNT_PATH):
#     https://console.cloud.google.com/iam-admin/serviceaccounts
#     Apri l'account → tab "Keys" → "Add Key" / "Delete Key"
#
# - Supabase service role (SUPABASE_SERVICE_ROLE_KEY):
#     https://supabase.com/dashboard/project/_/settings/api
#     "Reset service_role secret" — invalida tutte le sessioni
#     server, riconfigura subito i client che la usano.
#
# Il login a sottoscrizione (`jht oauth-login`) non si ruota da
# qui: si rifa' il login dal provider.
#
# Dopo ogni rotazione: aggiorna .env locale, riavvia i container/
# processi che la consumano, verifica con `jht providers status`
# (CLI) che tutti i canali ritornino "ok".
