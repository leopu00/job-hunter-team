# Tutti i file che finiscono nel container Linux devono essere LF.
# Senza queste rule Git su Windows applica CRLF e lo shebang
# `#!/usr/bin/env python3\r` rompe l'esecuzione nel container.
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.rs text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ps1 text eol=lf
Dockerfile text eol=lf

# Extensionless executables (python/bash/node wrappers)
agents/_tools/** text eol=lf
.launcher/** text eol=lf
cli/bin/** text eol=lf
.githooks/** text eol=lf

*.md text eol=lf

# File testuali di Godot: l'editor li riscrive sempre LF, senza queste
# rule ogni reimport su Windows produce centinaia di "M" fantasma.
*.import text eol=lf
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.svg text eol=lf

# Le trust root PEM entrano byte-per-byte nel progetto Godot/PCK. Un checkout
# Windows CRLF le rende diverse dalla rappresentazione approvata e il parser
# crittografico deve continuare a fallire chiuso, quindi e' Git a materializzare
# sempre la forma canonica LF (sia la copia producer sia quella consumer).
*.pem text eol=lf

# Fixture e documenti pubblicabili: non applicare conversioni EOL né diff testuali.
*.pdf binary
