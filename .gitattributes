# Tutti i file che finiscono nel container Linux devono essere LF.
# Senza queste rule Git su Windows applica CRLF e lo shebang
# `#!/usr/bin/env python3\r` rompe l'esecuzione nel container.
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
# `*.tsx` mancava, e la mancanza si vedeva solo da Windows: con i .ts in LF e i
# .tsx in CRLF, `prettier --check "web/**"` segnalava in locale TUTTI e 263 i
# .tsx e nessun .ts — cioè un gate che sembra rosso qui e verde in CI, che è il
# modo migliore per imparare a non fidarsi del gate (#181).
*.tsx text eol=lf
*.rs text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ps1 text eol=lf
Dockerfile text eol=lf

# Extensionless executables (python/bash/node wrappers)
agents/_tools/** text eol=lf
.launcher/** text eol=lf
cli/bin/** text eol=lf
.githooks/** text eol=lf

*.md text eol=lf

# File testuali di Godot: l'editor li riscrive sempre LF, senza queste
# rule ogni reimport su Windows produce centinaia di "M" fantasma.
*.import text eol=lf
*.gd text eol=lf
# `*.uid` mancava per lo stesso motivo per cui mancava `*.tsx` (#181): e' un
# tipo di file nato dopo la regola — Godot 4.4 ne scrive uno per ogni script.
# Misurato qui il 17/08: 173 dei 176 tracciati erano CRLF nel working tree, e
# i 3 LF erano quelli che Godot aveva appena riscritto. Cioe' il primo che
# tocca uno script si trova una "M" su un file il cui contenuto non e'
# cambiato.
*.uid text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.svg text eol=lf

# Fixture e documenti pubblicabili: non applicare conversioni EOL né diff testuali.
*.pdf binary
