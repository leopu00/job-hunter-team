#!/usr/bin/env bash
# Pre-commit hook — Job Hunter Team
# WHITELIST approach: solo estensioni esplicitamente permesse.
# Questo file e' protetto: non puo' essere rimosso o svuotato via commit.

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[0;33m'
NC='\033[0m'

# ── SELF-PROTECTION ──────────────────────────────────────────
# Blocca commit che rimuovono o svuotano questo hook
HOOK_PATH=".githooks/pre-commit"
if git diff --cached --name-only --diff-filter=D | grep -qx "$HOOK_PATH"; then
    echo -e "${RED}BLOCCATO: non puoi rimuovere il pre-commit hook.${NC}"
    exit 1
fi
# Lo stesso per lo script dei dati privati, che usano sia questo hook sia il pre-push.
if git diff --cached --name-only --diff-filter=D | grep -qx ".githooks/private-data.sh"; then
    echo -e "${RED}BLOCCATO: non puoi rimuovere .githooks/private-data.sh.${NC}"
    exit 1
fi
if git diff --cached --name-only | grep -qx "$HOOK_PATH"; then
    NEW_SIZE=$(git show :"$HOOK_PATH" 2>/dev/null | wc -c || echo 0)
    if [ "$NEW_SIZE" -lt 100 ]; then
        echo -e "${RED}BLOCCATO: non puoi svuotare il pre-commit hook.${NC}"
        exit 1
    fi
fi

# ── FILE D'IDENTITA' AGENTE (CLAUDE.md / AGENTS.md) ──────────
# Sono artefatti di RUNTIME, scritti nella workdir dell'agente dagli spawner:
# .launcher/start-agent.sh (JHT) e e2e-agents/spawn-e2e-agent.sh (collaudatori
# E2E). Il template nel repo e' la fonte di verita': la copia si rigenera a ogni
# spawn, quindi committarla congela un prompt che il template ha gia' superato.
# Convenzione provider: Claude Code legge CLAUDE.md, Codex e Kimi AGENTS.md —
# vanno bloccati entrambi, in qualunque directory.
# --diff-filter=ACM: una eventuale RIMOZIONE resta permessa, cosi' un file
# entrato per errore in passato puo' essere ripulito.
IDENTITY_FILES=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -iE '(^|/)(CLAUDE|AGENTS)\.md$' || true)
if [ -n "$IDENTITY_FILES" ]; then
    echo -e "${RED}BLOCCATO: file d'identita' agente, non committabili:${NC}"
    echo "$IDENTITY_FILES" | sed 's/^/  /'
    echo ""
    echo -e "${YELLOW}Sono generati a runtime. Correggi il TEMPLATE, non la copia:${NC}"
    echo -e "${YELLOW}  agents/<ruolo>/<ruolo>.md            (agenti JHT)${NC}"
    echo -e "${YELLOW}  e2e-agents/templates/<ruolo>/...     (collaudatori E2E)${NC}"
    exit 1
fi

# ── WHITELIST ESTENSIONI ─────────────────────────────────────
# Solo queste estensioni sono permesse. Tutto il resto e' bloccato.
#
# `baseline` è nell'elenco dal 2026-07-25: `.secrets.baseline` era entrata nel
# repo lo stesso giorno di questo hook (2026-04-27) e da allora nessuno poteva
# più aggiornarla — l'hook bloccava proprio il file che detect-secrets è fatto
# per rigenerare. Una baseline che non si può aggiornare invecchia e basta.
ALLOWED_EXTENSIONS="ts|tsx|gd|uid|tscn|tres|godot|cfg|ttf|import|js|jsx|json|geojson|css|scss|md|py|sh|sql|yml|yaml|toml|lock|svg|png|webp|txt|example|gitkeep|gitignore|gitattributes|gitleaksignore|gdignore|dockerignore|vercelignore|mjs|cjs|html|bat|ps1|icns|ico|rs|plist|list|jpg|jpeg|nsi|baseline|sha256"

BLOCKED_FILES=""
while IFS= read -r file; do
    # Permetti file senza estensione noti + file in .githooks/
    basename=$(basename "$file")
    if [[ "$basename" == "LICENSE" || "$basename" == "CODEOWNERS" || "$basename" == "Makefile" || "$basename" == "Procfile" || "$basename" == "Dockerfile" || "$basename" == "jht-send" || "$basename" == "jht-tmux-send" || "$basename" == "jht-telegram-send" || "$basename" == "jht-throttle" || "$basename" == "jht-throttle-check" || "$basename" == "jht-throttle-wait" || "$basename" == "throttle" || "$basename" == "throttle-ack" || "$basename" == "throttle-set" || "$basename" == "token-rate-now" || "$basename" == "jht-notify-user" || "$basename" == "jht-check-user-replies" || "$basename" == "jht-install" ]]; then
        continue
    fi
    if [[ "$file" == .githooks/* ]]; then
        continue
    fi
    # Unica fixture PDF ammessa: il test dedicato la rigenera byte-per-byte,
    # ne estrae il testo e applica il contratto privacy al contenuto binario.
    if [[ "$file" == "tests/fixtures/sample-cv.pdf" ]]; then
        continue
    fi

    # Unici media pubblici binari approvati per la home. L'eccezione resta sui
    # path esatti: qualunque altro MP4/VTT continua a essere bloccato. Hash,
    # peso e provenienza di questi file sono verificati dal test del manifest.
    if [[ "$file" == "web/public/media/home-video-r4-web.mp4" || "$file" == "web/public/media/home-video-r4-music.vtt" ]]; then
        continue
    fi

    # Estrai estensione
    ext="${basename##*.}"
    if [[ "$ext" == "$basename" ]]; then
        # Nessuna estensione — blocca (tranne file noti sopra)
        BLOCKED_FILES="$BLOCKED_FILES\n  $file"
        continue
    fi

    # Controlla whitelist
    if ! echo "$ext" | grep -qiE "^($ALLOWED_EXTENSIONS)$"; then
        BLOCKED_FILES="$BLOCKED_FILES\n  $file"
    fi
done < <(git diff --cached --name-only --diff-filter=ACM)

if [ -n "$BLOCKED_FILES" ]; then
    echo -e "${RED}BLOCCATO: file con estensione non permessa:${NC}"
    echo -e "$BLOCKED_FILES"
    echo ""
    echo -e "${YELLOW}Estensioni permesse: ${ALLOWED_EXTENSIONS}${NC}"
    echo -e "${YELLOW}Se serve aggiungere un'estensione, modifica .githooks/pre-commit${NC}"
    exit 1
fi

# ── BLOCCO PATTERN SENSIBILI NEI NOMI FILE ───────────────────
SENSITIVE_PATTERNS="CV_|CoverLetter_|curriculum|lettera_|resume_"
SENSITIVE_FILES=""
while IFS= read -r file; do
    if echo "$file" | grep -qiE "$SENSITIVE_PATTERNS"; then
        SENSITIVE_FILES="$SENSITIVE_FILES\n  $file"
    fi
done < <(git diff --cached --name-only --diff-filter=ACM)

if [ -n "$SENSITIVE_FILES" ]; then
    echo -e "${RED}BLOCCATO: file con nome che sembra un documento personale:${NC}"
    echo -e "$SENSITIVE_FILES"
    exit 1
fi

# ── DATI PRIVATI DI PERSONE E MACCHINE ───────────────────────
# IP pubblici, email reali e token: le regole stanno in .githooks/private-data.sh,
# lo stesso script che il pre-push applica a ogni commit in uscita. Accanto a
# questo file, non nella cartella corrente: i test lanciano l'hook da un altro repo.
# Se lo script manca, il commit si ferma: un controllo sparito non e' un via.
PRIVATE_DATA="$(dirname "${BASH_SOURCE[0]}")/private-data.sh"
if [ ! -f "$PRIVATE_DATA" ]; then
    echo -e "${RED}BLOCCATO: manca $PRIVATE_DATA (controllo dei dati privati).${NC}"
    exit 1
fi
bash "$PRIVATE_DATA" --staged || exit 1

# ── BLOCCO DIRECTORY SENSIBILI ────────────────────────────────
SENSITIVE_DIRS="shared/data/applications|shared/data/linkedin|__pycache__"
SENSITIVE_DIR_FILES=""
while IFS= read -r file; do
    if echo "$file" | grep -qiE "^($SENSITIVE_DIRS)"; then
        SENSITIVE_DIR_FILES="$SENSITIVE_DIR_FILES\n  $file"
    fi
done < <(git diff --cached --name-only --diff-filter=ACM)

if [ -n "$SENSITIVE_DIR_FILES" ]; then
    echo -e "${RED}BLOCCATO: file in directory sensibile:${NC}"
    echo -e "$SENSITIVE_DIR_FILES"
    exit 1
fi

exit 0
