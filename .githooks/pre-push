#!/usr/bin/env bash
# Pre-push hook — Job Hunter Team
#
# Rete di sicurezza per i file d'identita' agente (CLAUDE.md / AGENTS.md).
# Il pre-commit li blocca gia', ma `git commit --no-verify` lo aggira: senza
# questo secondo livello il divieto sarebbe solo una convenzione. Qui si guarda
# a cosa sta per raggiungere il remote, quindi intercetta anche i commit nati
# con --no-verify, un cherry-pick o un merge da un ramo non protetto.
#
# Stesso discorso per i dati privati (IP pubblici, email, token): le regole del
# pre-commit, in .githooks/private-data.sh, su ogni commit in uscita. Se
# gitleaks e' installato, gira anche lui sullo stesso intervallo.
#
# stdin: <local ref> <local sha> <remote ref> <remote sha>, una riga per ref.

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[0;33m'
NC='\033[0m'

ZERO="0000000000000000000000000000000000000000"
OFFENDING=""
HOOK_DIR="$(dirname "${BASH_SOURCE[0]}")"
PRIVATE_DATA="$HOOK_DIR/private-data.sh"
if [ ! -f "$PRIVATE_DATA" ]; then
    echo -e "${RED}PUSH BLOCCATO: manca $PRIVATE_DATA (controllo dei dati privati).${NC}"
    exit 1
fi
# Gli SHA in uscita, per il controllo dei dati privati; le basi, per gitleaks.
OUTGOING=$(mktemp "${TMPDIR:-/tmp}/jht-pre-push.XXXXXX")
trap 'rm -f "$OUTGOING"' EXIT
TIPS=""

while read -r _local_ref local_sha _remote_ref remote_sha; do
    # Cancellazione di un ref: niente contenuto da ispezionare.
    [ "$local_sha" = "$ZERO" ] && continue

    # Ispeziona soltanto commit non ancora raggiungibili da alcun ref remoto.
    # Un merge master -> production rende raggiungibili dalla production molti
    # commit gia' pubblicati su origin/master: riesaminarli non aggiunge
    # protezione e genera falsi blocchi su esempi storici. Il nuovo merge commit,
    # invece, non e' ancora su alcun ref remoto e viene sempre controllato.
    commits=$(git rev-list "$local_sha" --not --remotes || true)

    [ -z "$commits" ] && continue
    TIPS="$TIPS $local_sha"

    while IFS= read -r commit; do
        [ -z "$commit" ] && continue
        hits=$(git diff-tree --no-commit-id --name-only -r --diff-filter=ACM "$commit" \
               | grep -iE '(^|/)(CLAUDE|AGENTS)\.md$' || true)
        if [ -n "$hits" ]; then
            while IFS= read -r f; do
                OFFENDING="$OFFENDING\n  ${commit:0:9}  $f"
            done <<< "$hits"
        fi

        printf '%s\n' "$commit" >> "$OUTGOING"
    done <<< "$commits"
done

BLOCKED=0

if [ -n "$OFFENDING" ]; then
    echo -e "${RED}PUSH BLOCCATO: file d'identita' agente nei commit.${NC}"
    echo -e "$OFFENDING"
    echo ""
    echo -e "${YELLOW}I file d'identita' sono artefatti di runtime: il template nel repo${NC}"
    echo -e "${YELLOW}e' la fonte di verita'.${NC}"
    BLOCKED=1
fi

# Dati privati: le stesse regole del pre-commit, su ogni commit in uscita.
# Serve perche' --no-verify scavalca il pre-commit, e un IP di VPS pubblicato
# non si cancella: si revoca.
if [ -s "$OUTGOING" ]; then
    sort -u "$OUTGOING" | bash "$PRIVATE_DATA" --commits || BLOCKED=1
fi

# gitleaks, se c'e': stesso intervallo (commit non ancora su alcun ref remoto),
# configurazione del repo (.gitleaks.toml, .gitleaksignore). Fermano solo i
# segreti trovati (uscita 3); un gitleaks vecchio o rotto avvisa e non blocca,
# perche' e' un controllo in piu' e non deve fermare i push di tutti.
if [ -n "$TIPS" ] && command -v gitleaks >/dev/null 2>&1; then
    TOP=$(git rev-parse --show-toplevel)
    for tip in $TIPS; do
        rc=0
        report=$(cd "$TOP" && gitleaks git --log-opts="$tip --not --remotes" \
            --redact --no-banner --no-color --exit-code 3 --timeout 120 \
            --log-level warn -v . 2>&1) || rc=$?
        if [ "$rc" -eq 3 ]; then
            echo -e "${RED}PUSH BLOCCATO: gitleaks ha trovato segreti (commit, file, regola).${NC}"
            printf '%s\n' "$report" | grep -E '^(RuleID|File|Line|Commit|Finding):' | sed 's/^/  /'
            echo ""
            BLOCKED=1
        elif [ "$rc" -ne 0 ]; then
            echo -e "${YELLOW}Avviso: gitleaks non e' riuscito a controllare ${tip:0:9} (uscita $rc), saltato.${NC}"
        fi
    done
fi

if [ "$BLOCKED" -ne 0 ]; then
    echo -e "${YELLOW}Per toglierli dalla storia che stai pubblicando:${NC}"
    echo -e "${YELLOW}  git rm --cached <file> && git commit --amend    (ultimo commit)${NC}"
    echo -e "${YELLOW}  git rebase -i <base>                            (commit piu' vecchi)${NC}"
    exit 1
fi

exit 0
