{
  "about": "The fields the team needs before it can start, and the profiles that prove every place that reads them gives the same answer. Read by tests/test_profile_minimum_checklist.py (shared/skills/validate_profile.py --minimum) and web/lib/profile-minimum-parity.test.ts (web/lib/profile-completion.ts). Experience and education are recommended, not required (decision of 2026-06-06).",
  "required": [
    "name",
    "email",
    "target_role",
    "location",
    "experience_years",
    "seniority_target",
    "skills",
    "languages"
  ],
