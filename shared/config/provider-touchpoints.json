{
  "schema_version": 1,
  "canonical_team_providers": ["claude", "openai", "kimi"],
  "canonical_agent_harnesses": ["codex", "pi"],
  "touchpoints": [
    {"id": "config-schema", "concern": "validation and role-scoped local override", "path": "shared/config/schema.ts", "anchors": ["AIProviderSchema", "LocalScorerSchema"]},
    {"id": "config-types", "concern": "canonical TypeScript provider names", "path": "shared/config/types.ts", "anchors": ["AIProviderName", "LocalScorerConfig"]},
    {"id": "setup-catalog", "concern": "onboarding provider catalog", "path": "cli/wizard/setup-helpers.js", "anchors": ["AI_PROVIDERS", "active_provider"]},
    {"id": "provider-cli", "concern": "list, select, install, update, and model pin", "path": "cli/src/commands/providers.js", "anchors": ["KNOWN_PROVIDERS", "active_provider"]},
    {"id": "provider-version-pin", "concern": "CLI version this release installs (issue #130: no mutable tag)", "path": "shared/config/provider-versions.json", "anchors": ["pins", "codex", "pinned_at"]},
    {"id": "provider-version-pin-loader", "concern": "read the pin and compose the install spec", "path": "shared/runtime/provider-pins.js", "anchors": ["pinnedVersion", "installSpec"]},
    {"id": "agent-harness-catalog", "concern": "the harnesses (codex, pi) and which provider may run which", "path": "shared/runtime/agent-harness.js", "anchors": ["AGENT_HARNESSES", "harnessProblem", "usesPi"]},
    {"id": "agent-harness-config", "concern": "the harness key of the config", "path": "shared/config/schema.ts", "anchors": ["AgentHarnessSchema", "harness"]},
    {"id": "agent-harness-setup", "concern": "the harness question of the first setup and its two open product decisions", "path": "cli/wizard/setup-harness.js", "anchors": ["promptHarness", "harnessNote"]},
    {"id": "agent-harness-login", "concern": "Pi login in the setup and its marker", "path": "cli/wizard/pi-login.js", "anchors": ["runPiLoginStep", "PI_CODING_AGENT_DIR"]},
    {"id": "agent-harness-cli", "concern": "show and change the harness; check the pi of the image", "path": "cli/src/commands/providers-harness.js", "anchors": ["handleHarness", "checkPi", "registerProvidersHarness"]},
    {"id": "agent-harness-cli-of-config", "concern": "team start: the CLI that drives the agents follows the harness", "path": "cli/src/commands/team/agents.js", "anchors": ["providerCli", "usesPi"]},
    {"id": "agent-harness-launch", "concern": "per-agent harness, provider check and pi command for every role", "path": ".launcher/spawn-lib.sh", "anchors": ["jht_pi_provider_check", "jht_pi_args", "jht_pi_version_check"]},
    {"id": "agent-harness-launch-config", "concern": "read the harness of the config; the CLI of Dottore and Mantenitore", "path": ".launcher/spawn-harness.sh", "anchors": ["JHT_AGENT_HARNESSES", "jht_agent_harness", "jht_role_harness", "jht_config_harness", "jht_spawn_active_cli", "jht_pi_bin"]},
    {"id": "agent-harness-boot-login", "concern": "boot gate: the login marker follows the harness", "path": "cli/src/commands/pid1.js", "anchors": ["hasProviderCredentials", "loginMarkerOf"]},
    {"id": "agent-harness-watchdog-login", "concern": "watchdog gate: the login marker follows the harness", "path": ".launcher/agent-watchdog.sh", "anchors": ["config_ready", ".pi/agent/auth.json"]},
    {"id": "agent-launch-api-key-file", "concern": "the API key of a run from a tmpfs file, never in the pane command", "path": ".launcher/spawn-keyfile.sh", "anchors": ["jht_key_wrap", "api_key_file.py"]},
    {"id": "agent-launch", "concern": "provider CLI dispatch and local Scorer dispatch", "path": ".launcher/start-agent.sh", "anchors": ["extract_provider_info", "LOCAL_SCORER_RUNNER"]},
    {"id": "local-scorer-adapter", "concern": "OpenAI-compatible request, canonical liveness/future-feedback context, response validation, and persistence boundary", "path": "shared/skills/local_scorer.py", "anchors": ["check_liveness", "request_score", "query_feedback_context", "score_to_db_args"]},
    {"id": "provider-health", "concern": "runtime provider health checks", "path": "cli/src/commands/doctor.js", "anchors": ["active_provider", "providers"]},
    {"id": "usage-fetch", "concern": "provider-specific usage collection", "path": "shared/skills/check_usage.py", "anchors": ["provider", "claude"]},
    {"id": "usage-record", "concern": "normalize provider usage samples", "path": "shared/skills/usage_record.py", "anchors": ["provider", "usage"]},
    {"id": "usage-start-probe", "concern": "one-shot 5h/weekly limits read before the desktop starts the team", "path": ".launcher/sentinel-bridge.py", "anchors": ["_probe_fetch", "limits_verdict", "--probe-limits"]},
    {"id": "capacity-policy", "concern": "provider capacity and pacing", "path": "shared/skills/provider_capacity.py", "anchors": ["read_active_provider", "provider"]},
    {"id": "plan-registry", "concern": "subscription plan semantics", "path": "shared/skills/plan_registry.py", "anchors": ["normalize_provider", "active_provider"]},
    {"id": "web-provider-data", "concern": "cloud UI provider metadata", "path": "web/lib/providers.ts", "anchors": ["Provider", "claude"]},
    {"id": "web-credentials", "concern": "credential status API", "path": "web/app/api/credentials/route.ts", "anchors": ["provider", "credentials"]},
    {"id": "container-network", "concern": "host endpoint reachability from the runtime", "path": "docker-compose.yml", "anchors": ["host.docker.internal:host-gateway"]}
  ]
}
