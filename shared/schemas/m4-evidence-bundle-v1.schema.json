{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobhunterteam.ai/schemas/m4-evidence-bundle-v1.schema.json",
  "title": "Job Hunter Team M4 evidence-bundle manifest",
  "description": "A fail-closed manifest for reproducible, scrubbed M4 Kimi-window and explicit-cost analyses. Validation proves reproducibility, not external validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "bundle_id",
    "tested_commit",
    "provenance",
    "analyses"
  ],
  "properties": {
    "$schema": {
      "const": "https://jobhunterteam.ai/schemas/m4-evidence-bundle-v1.schema.json"
    },
    "schema_version": { "const": 1 },
    "bundle_id": { "$ref": "#/$defs/stableId" },
    "tested_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "analyses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kimi_windows", "cost_comparison"],
      "properties": {
        "kimi_windows": {
          "allOf": [
            { "$ref": "#/$defs/dataset" },
            {
              "properties": {
                "parameters": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["targets", "min_windows"],
                  "properties": {
                    "targets": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "type": "number", "minimum": 0, "maximum": 100 }
                    },
                    "min_windows": { "type": "integer", "minimum": 2 }
                  }
                }
              }
            }
          ]
        },
        "cost_comparison": {
          "allOf": [
            { "$ref": "#/$defs/dataset" },
            {
              "properties": {
                "parameters": {
                  "type": "object",
                  "additionalProperties": false,
                  "maxProperties": 0
                }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "source_type", "scrubbed_export", "description"],
      "properties": {
        "classification": {
          "type": "string",
          "enum": ["fixture", "unclassified", "live"]
        },
        "source_type": {
          "type": "string",
          "enum": ["synthetic_fixture", "scrubbed_export", "scrubbed_live_export"]
        },
        "scrubbed_export": { "const": true },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "allOf": [
        {
          "if": { "properties": { "classification": { "const": "fixture" } } },
          "then": { "properties": { "source_type": { "const": "synthetic_fixture" } } }
        },
        {
          "if": { "properties": { "classification": { "const": "unclassified" } } },
          "then": { "properties": { "source_type": { "const": "scrubbed_export" } } }
        },
        {
          "if": { "properties": { "classification": { "const": "live" } } },
          "then": { "properties": { "source_type": { "const": "scrubbed_live_export" } } }
        }
      ]
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "provenance", "input", "parameters"],
      "properties": {
        "dataset_id": { "$ref": "#/$defs/stableId" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "parameters": { "type": "object" }
      }
    }
  }
}
