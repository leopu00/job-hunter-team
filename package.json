{
  "name": "job-hunter-team",
  "version": "0.1.25",
  "description": "An open-source multi-agent AI framework that automates your job search — from position discovery to tailored CVs and cover letters.",
  "repository": {
    "type": "git",
    "url": "https://github.com/leopu00/job-hunter-team.git"
  },
  "homepage": "https://jobhunterteam.ai",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:up": "bash scripts/dev-up.sh",
    "dev:down": "bash scripts/dev-down.sh",
    "lint": "npm run lint --prefix web",
    "format:check": "npx prettier --check \"web/app/**/*.{ts,tsx}\" \"shared/**/*.ts\"",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:test": "npm --prefix desktop run test",
    "desktop:dist": "npm --prefix desktop run dist",
    "desktop:dist:mac": "npm --prefix desktop run dist:mac",
    "desktop:dist:win": "npm --prefix desktop run dist:win",
    "desktop:dist:linux": "npm --prefix desktop run dist:linux"
  },
  "keywords": [],
  "author": "Leone Emanuel Puglisi <leopu00@gmail.com>",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "zod": "^4.3.6"
  }
}
