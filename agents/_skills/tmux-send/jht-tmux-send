#!/usr/bin/env bash
# jht-tmux-send — consegna atomica e VERIFICATA di un messaggio a una
# sessione tmux. Pensato per agent-to-agent via TUI (Claude / Codex / Kimi).
#
# Le TUI "Ink" (Codex, Kimi, Claude Code) non registrano l'Enter se
# arriva prima che il testo sia renderizzato nel prompt: testo e Enter
# vanno inviati in step separati, e il submit deve arrivare DOPO che il
# testo e' effettivamente apparso nel pane.
#
# Schema (rivisto il 23/10: il testo si scrive UNA volta, «preso» ha bisogno di una prova):
#   0. lock per sessione       una consegna alla volta verso lo stesso pane (flock su un file per
#                              sessione, tenuto fino alla verifica; cade con il processo)
#   1. capture-pane            si GUARDA prima di digitare: serve una casella di input. Senza (modale
#                              di primo avvio o shell nuda) un solo Escape, poi si guarda di nuovo;
#                              ancora niente = exit 3, senza aver digitato
#   2. send -l "$message"      tmux typea il testo, UNA volta. Se la casella contiene gia' il nostro
#                              testo (una chiamata precedente) non si riscrive: si preme solo l'Invio
#   3. capture-pane (poll)     la firma si cerca SOLO nella casella (non nella conversazione); se non
#                              compare entro il tempo del render: exit 3, senza riscrivere e senza
#                              premere niente
#   4. send Enter              submit; dal secondo tentativo Space+Enter, ma solo se nella casella c'e'
#                              ancora il nostro testo (mai un Invio su una domanda di permesso)
#   5. capture-pane            «PRESO» = una PROVA: il testo era nella casella e adesso la casella e'
#                              disegnata e vuota, oppure ha una ricorrenza in piu' nella conversazione,
#                              oppure il turno e' partito adesso. Pane occupato da solo NON prova niente.
#
# ⚠️ "VIVO MA MUTO" (delia 28-30/07, 4 occorrenze in 3 giorni, Capitano incluso).
# Fino al 30/07 lo step 6 non esisteva: bastava vedere il testo nel composer per
# mandare Enter e dichiarare successo (exit 0). Ma esiste uno stato in cui la TUI
# ACCETTA il testo e IGNORA l'Enter — osservato quando un messaggio arriva mentre
# l'agente sta chiudendo un turno lungo: l'input successivo non viene mai
# committato. Risultato: pane vivo, riga appesa nel prompt, agente fermo per ore,
# e un chiamante convinto di aver consegnato. La consegna non e' "aver scritto":
# e' "aver visto partire il turno".
#
# Uso:
#   jht-tmux-send SESSION "[@capitano -> @scout-1] [MSG] ..."
#
# Exit:
#   0 → messaggio consegnato e submittato (submit VERIFICATO)
#   1 → argomenti mancanti
#   2 → sessione inesistente
#   3 → testo mai apparso nel pane E pane NON occupato → TUI irricettiva
#       (probabile bash nudo post-crash / modal bloccato): unico segnale "morto".
#   4 → TUI occupata (turno in corso) oltre il budget d'attesa → agente VIVO:
#       messaggio NON consegnato in sincrono, il chiamante deve RIPROVARE piu'
#       tardi, MAI spawnare un rimpiazzo. "Busy != morto": confonderli e' la
#       causa radice dell'overspawn del 07/06 (6→16 agenti in 3 giorni,
#       weekly Codex al 100%, halt forzato di ~3,5 giorni).
#   5 → testo ACCETTATO nel composer ma submit mai avvenuto dopo N Enter →
#       agente VIVO ma incastrato ("vivo ma muto"). Come rc=4 il chiamante deve
#       RIPROVARE, MAI spawnare un rimpiazzo: il pane non e' morto, ha solo una
#       riga appesa nel prompt. Distinto da 3 apposta — rc=3 e' l'unico che
#       autorizza l'escalation-per-morte (pacing-bridge.py:1493).
#   6 → IMPERSONAZIONE: la busta dichiara un agente diverso da quello in cui
#       questo processo gira davvero. Il messaggio NON parte. Non e' un guasto
#       del destinatario e riprovare non serve: e' il mittente a doversi
#       correggere. Il tentativo resta scritto in messages.jsonl con
#       delivered=false, cosi' chi indaga trova una traccia invece del nulla
#       (#198).
#   7 → NON SO: il testo e' uscito dalla casella ma non c'e' prova che sia stato preso (nessuna
#       ricorrenza in piu' nella conversazione, turno non partito), o non e' piu' nella casella dopo un
#       Invio. NON e' un guasto e NON autorizza respawn; il chiamante guarda prima di riscrivere.
#   8 → LOCK OCCUPATO: un'altra consegna alla stessa sessione e' ancora in corso dopo JHT_TMUX_LOCK_WAIT
#       secondi (12). Non e' stato digitato niente: si puo' ritentare.
#   (il 3 resta il solo segnale «forse morto» su cui conta pacing-bridge: nessuna casella a schermo, o
#    testo digitato una volta e MAI comparso nella casella)

set -euo pipefail

if [ $# -lt 2 ]; then
  echo "Usage: jht-tmux-send <session> <message>" >&2
  echo "Esempio: jht-tmux-send SCOUT-1 '[@capitano -> @scout-1] [MSG] Inizia il loop.'" >&2
  exit 1
fi

session="$1"
shift
# Supportiamo sia la forma "quotata" (un solo arg) sia lo splat accidentale
# (piu' arg con spazi) — in quest'ultimo caso ricomponiamo con spazi.
message="$*"

if ! tmux has-session -t "$session" 2>/dev/null; then
  echo "jht-tmux-send: sessione '$session' non esiste" >&2
  exit 2
fi

# ── #198 · chi manda DAVVERO ────────────────────────────────────────────────
# L'identita' del mittente viveva SOLO dentro il corpo del messaggio, come
# busta "[@x -> @y]" scritta da chi lo componeva: una convenzione di
# visualizzazione messa a fare il lavoro di un'autenticazione. Chiunque avesse
# una shell nel container poteva firmarsi come chiunque.
#
# ⚠️ Il rimedio che viene naturale NON regge, ed e' stato provato prima di
# scartarlo: `tmux display-message -p '#{session_name}'` con TMUX_PANE=%99
# davanti risponde il nome di un'ALTRA sessione. Sarebbe stato sostituire una
# variabile scegliibile (JHT_AGENT_DIR) con un'altra variabile scegliibile.
# Qui l'origine si deriva dalla PARENTELA DEI PROCESSI: tmux conosce il
# pane_pid di ogni pane e un processo non puo' mentire su chi lo ha generato.
#
# Se il modulo manca o python non c'e', il messaggio parte ma NON eredita
# fiducia: resta "unverified" e chi legge lo vede addosso al testo. Una difesa
# che non sa decidere deve dirlo, non tacere.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ORIGIN_LIB="/app/shared/skills/message_origin.py"
[ -f "$ORIGIN_LIB" ] || ORIGIN_LIB="${SCRIPT_DIR}/../../../shared/skills/message_origin.py"

sender_trust="unverified"
sender_claimed=""
sender_origin=""
if [ -f "$ORIGIN_LIB" ] && command -v python3 >/dev/null 2>&1; then
  if verdict=$(python3 "$ORIGIN_LIB" "$message" 2>/dev/null); then
    # La prima riga senza una pipe verso `head`: con `set -o pipefail` il
    # printf a sinistra prende SIGPIPE se head e' gia' uscito, e lo script
    # moriva con 141 senza una parola (in CI sotto xdist; in locale 3 corse
    # su 1400 del sender; la sonda ERR ha indicato questa riga).
    verdict_head=${verdict%%$'\n'*}
    sender_trust=$(printf '%s' "$verdict_head" | cut -f1)
    sender_claimed=$(printf '%s' "$verdict_head" | cut -f2)
    sender_origin=$(printf '%s' "$verdict_head" | cut -f3)
    # Il messaggio torna con il verdetto addosso: il marchio deve arrivare nel
    # PANE, perche' l'unico consumatore che AGISCE e' l'agente che legge. Un
    # verdetto che resta in messages.jsonl serve all'analisi a posteriori e non
    # protegge nessuno mentre sta succedendo.
    message=$(printf '%s' "$verdict" | tail -n +2)
  fi
fi

if [ "$sender_trust" = "impersonation" ]; then
  # Il tentativo si registra PRIMA di rifiutarlo: una difesa che blocca in
  # silenzio non lascia niente da guardare a chi indaga.
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$session" "$sender_claimed" "$sender_origin" "$message" <<'REFUSEDEOF' 2>/dev/null || true
import json, os, sys
from datetime import datetime, timezone
session, claimed, origin, msg = sys.argv[1:5]
log_dir = os.path.join(os.environ.get("JHT_HOME") or os.path.expanduser("~/.jht"), "logs")
os.makedirs(log_dir, exist_ok=True)
with open(os.path.join(log_dir, "messages.jsonl"), "a") as f:
    f.write(json.dumps({
        "ts": datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z"),
        "session": session, "from": origin, "to": session.lower(), "type": "",
        "from_claimed": claimed, "from_verified": origin, "from_trust": "impersonation",
        "delivered": False, "preview": msg[:80], "body": msg[:4096],
    }, ensure_ascii=False) + "\n")
REFUSEDEOF
  fi
  echo "jht-tmux-send: refusing to deliver — the envelope claims '@${sender_claimed}' but this process runs in '${sender_origin}'" >&2
  exit 6
fi

# ── JHT-T09 · la posta con ack ───────────────────────────────────────────────
# Per i destinatari elencati in `mail_receivers` (jht.config.json: vuoto o illeggibile
# = nessuno), un messaggio FRA AGENTI diventa un file nella loro casella, con una
# ricevuta; nel terminale si digita solo un sollecito corto, senza contenuto. Il
# mittente lo decide `jht_mail.py route` dalla stessa parentela dei processi di
# sopra: l'utente, i bridge, il watchdog e chiunque non sia verificabile restano sul
# percorso di sempre (qui sotto, byte per byte). Il verdetto di impersonazione e'
# gia' stato dato: il router non lo rivede.
#
# ⚠️ Da qui l'exit 0 vuol dire «IN CODA»: il messaggio e' durevole, non e' detto che
# l'agente l'abbia preso. «Preso» lo dice `jht-mail status`. Gli exit del SOLLECITO
# (4/5/6: pane vivo ma occupato o muto) non sono piu' un messaggio perso, quindi
# escono 0; il 3 (pane che non risponde) resta 3, perche' autorizza la verifica di
# vita. Il sollecito passa dal percorso di oggi, forzato: non rientra nel router.
mail_id=""
MAIL_LIB="/app/shared/skills/jht_mail.py"
[ -f "$MAIL_LIB" ] || MAIL_LIB="${SCRIPT_DIR}/../../../shared/skills/jht_mail.py"
if [ "$sender_trust" = "verified" ] && [ -f "$MAIL_LIB" ] && command -v python3 >/dev/null 2>&1; then
  if routed=$(printf '%s' "$message" | python3 "$MAIL_LIB" route "$session" 2>/dev/null); then
    mail_id=${routed%%$'\t'*}
  fi
fi

mail_nudge_held=0
_mail_exit() {
  local rc="$1"
  trap - EXIT
  if [ "$mail_nudge_held" = 1 ]; then
    echo "jht-tmux-send: queued $mail_id in the mailbox of $session; nudge held, the terminal is not at its prompt (it will be repeated)"
    exit 0
  fi
  case "$rc" in
    0) echo "jht-tmux-send: queued $mail_id in the mailbox of $session (nudge delivered)" ;;
    3) echo "jht-tmux-send: queued $mail_id in the mailbox of $session, but the terminal does not respond (rc=3)" >&2
       exit 3 ;;
    *) echo "jht-tmux-send: queued $mail_id in the mailbox of $session; nudge unconfirmed (rc=$rc), it will be repeated" >&2
       exit 0 ;;
  esac
}
if [ -n "$mail_id" ]; then
  trap '_mail_exit $?' EXIT
fi

# Provider attivo: serve a sapere se la TUI di destinazione è Kimi, che
# accoda i messaggi inviati con solo Enter mentre l'agente è in mezzo a
# tool calls in-flight (osservato live: SCOUT-1 con 4 throttle in coda
# non processati). Soluzione: dopo Enter mandiamo anche Ctrl-S, che in
# Kimi forza il submit del prompt corrente. Su Claude/Codex Ctrl-S non
# è atteso, quindi lo aggiungiamo SOLO se active_provider == "kimi".
provider=""
config_path="${JHT_HOME:-$HOME/.jht}/jht.config.json"
if [ -f "$config_path" ] && command -v python3 >/dev/null 2>&1; then
  provider=$(python3 -c "import json,sys
try:
  print(json.load(open(sys.argv[1])).get('active_provider',''))
except Exception:
  pass" "$config_path" 2>/dev/null || true)
fi
# Il Ctrl-S è per la CLI di Kimi, non per il provider: una sessione che
# start-agent.sh ha marcato con l'harness pi non lo riceve, anche su Kimi.
if [ "$provider" = "kimi" ] && \
   [ "$(tmux show-options -qv -t "=$session" @jht_harness 2>/dev/null)" = "pi" ]; then
  provider="kimi-on-pi"
fi

# Log strutturato per la UI live: parsa il formato "[@from -> @to] [TYPE] ..."
# e appendix una riga JSONL in $JHT_HOME/logs/messages.jsonl. Il backend
# Next legge questo file per animare il pallino tra i nodi del team chart.
# Fallisce silenziosamente — il logging non deve mai bloccare l'invio.
if command -v python3 >/dev/null 2>&1; then
  JHT_MAIL_ID="$mail_id" python3 - "$session" "$message" "$sender_trust" "$sender_claimed" "$sender_origin" <<'PYEOF' 2>/dev/null || true
import json, os, re, sys
from datetime import datetime, timezone
session, msg = sys.argv[1], sys.argv[2]
trust, claimed, origin = (sys.argv[3:6] + ["", "", ""])[:3]
mail_id = os.environ.get("JHT_MAIL_ID", "")
# 1) formato standard agente→agente: "[@from -> @to] [TYPE] ..."
m = re.match(r'^\s*\[@([a-zA-Z0-9_-]+)\s*->\s*@([a-zA-Z0-9_-]+)\]\s*(?:\[([A-Z]+)\])?', msg)
if m:
    from_, to_, kind = m.group(1), m.group(2), m.group(3) or ""
else:
    # 2a) pacing-bridge: "[BRIDGE PACING] ..." — nodo separato dal Bridge
    #     classico (sentinel) nel team chart. Marcato come from=pacing per
    #     far partire il pallino dal nodo Pacing → Capitano.
    mp = re.match(r'^\s*\[BRIDGE\s+PACING\]', msg)
    if mp:
        from_, to_, kind = "pacing", session.lower(), "PACING"
    # 2b) bridge automatico: "[BRIDGE TICK|FAILURE|ALERT|INFO] ..." → la
    #     destinazione è la session destinataria (passata come argv[1]).
    elif (mb := re.match(r'^\s*\[BRIDGE\s+([A-Z]+)\]', msg)):
        from_, to_, kind = "bridge", session.lower(), mb.group(1)
    else:
        # 3) sentinella autonoma: "[SENTINELLA] ..." o "[SENTINELLA] [TYPE] ..."
        ms = re.match(r'^\s*\[SENTINELLA\]\s*(?:\[([A-Z]+)\])?', msg)
        if ms:
            from_, to_, kind = "sentinella", session.lower(), ms.group(1) or ""
        else:
            from_, to_, kind = "", "", ""
log_dir = os.path.join(os.environ.get("JHT_HOME") or os.path.expanduser("~/.jht"), "logs")
os.makedirs(log_dir, exist_ok=True)
out = {
    "ts": datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z"),
    "session": session,
    "from": from_.lower(),
    "to": to_.lower(),
    "type": kind,
    # Keep preview for backwards compat with older readers, but also persist
    # the FULL message body so the case-studies UI can show what the agents
    # actually said. Cap at 4kB just to bound the log line size.
    "preview": msg[:80],
    "body": msg[:4096],
    # #198 — l'identita' DICHIARATA e quella DERIVATA restano due campi
    # distinti: fonderle rifarebbe il difetto, perche' chi legge non potrebbe
    # piu' sapere quale delle due sta guardando.
    #
    # `from` resta com'era di proposito: e' l'unico campo che i lettori
    # esistenti conoscono — la UI del team chart e i case studies — e per i
    # messaggi di sistema (BRIDGE, SENTINELLA, PACING) porta il nodo giusto,
    # che non e' la sessione da cui il daemon gira. Il caso pericoloso non
    # arriva comunque fin qui: un'impersonazione viene rifiutata prima, e
    # registrata con delivered=false.
    "from_claimed": claimed,
    "from_verified": origin,
    "from_trust": trust,
    # A message that went into a mailbox is queued, not delivered: «preso» is the mailbox's to say.
    "delivered": not mail_id,
}
if mail_id:
    out["mail_state"] = "queued"
    out["mail_id"] = mail_id
with open(os.path.join(log_dir, "messages.jsonl"), "a") as f:
    f.write(json.dumps(out, ensure_ascii=False) + "\n")
PYEOF
fi

# Un messaggio in coda nella casella: quello che si digita e' solo il sollecito.
# Le stesse parole di `nudge_text(1)` in jht_mail.py (un test le tiene uguali).
if [ -n "$mail_id" ]; then
  message="[MAIL] 1 new message(s) in your mailbox. Run: jht-mail drain"
  # JHT-T09 fase 3b · il sollecito si digita SOLO se il terminale e' al prompt (stessa regola della
  # chat dell'utente, `agent_chat.prompt_state`): durante un turno puo' comparire un menu o una domanda
  # di permesso, e un tasto digitato sopra la risponde. Altrimenti non si digita niente: il messaggio
  # resta in coda e il richiamo del watchdog ritenta.
  if ! python3 "$MAIL_LIB" nudge "$session" "$mail_id" >/dev/null 2>&1; then
    mail_nudge_held=1
    exit 0
  fi
fi

# Signature per la verify: testa E coda del messaggio. La testa basta per i
# messaggi corti, ma un prompt lungo puo' occupare piu' dell'altezza del pane:
# mentre Ink lo rende, i primi caratteri scorrono fuori da capture-pane e il
# sender conclude a torto che il testo non sia mai apparso. La coda resta
# invece accanto al cursore ed e' quindi la prova piu' stabile.
# `head` legge da una sostituzione di processo, non da una pipeline: se si
# ferma ai 30 byte, il SIGPIPE del printf non e' l'esito del comando
# (`set -o pipefail` lo trasformerebbe in un exit 141 muto, come al verdetto).
signature_head=$(head -c 30 < <(printf '%s' "$message"))
signature_tail=$(printf '%s' "$message" | tail -c 30)

# Busy-detection: codex / claude / kimi mostrano "esc to interrupt" mentre
# l'agente e' a meta' turno. Un pane occupato e' un agente VIVO: il messaggio
# viene comunque digitato/accodato subito; se la verifica non e' possibile,
# il record durable dichiara queued/delivery-unverified, mai drop.
# Causa radice dell'overspawn del 07/06: 6→16 agenti in 3 giorni, weekly Codex
# al 100%, halt forzato di ~3,5 giorni.
#
# ⚠️ FALSO-OCCUPATO (andris 30/07, seconda volta in un giorno). Fino al 30/07
# questo match era una substring su TUTTO il pane, prosa del transcript inclusa.
# Il Capitano ha scritto nella propria risposta:
#     All three workers are idle at the prompt (no spinner, no "esc to
#     interrupt") — halted as expected.
# e da quel momento OGNI jht-tmux-send verso di lui ha visto il pane occupato,
# atteso 90s e rinunciato con exit 4: 16 tick PACE-GUARD non consegnati, 10 di
# fila. Si e' auto-zittito citando la stringa magica. Un agente puo' e deve
# poter parlare del proprio stato senza diventare irraggiungibile.
#
# Ora si distingue la RIGA DI STATO dalla prosa con tre criteri, tarati su righe
# vere raccolte dalla flotta:
#   ◦ Working (16s • esc to interrupt)                       → STATO   (leone)
#   ● All three workers running (esc to interrupt). Recording…→ prosa (agent)
#   All three are now running (esc to interrupt confirmed…).  → prosa (agent)
#   …then confirm esc to interrupt before calling it fixed.   → prosa (delia)
# 1. solo le ultime righe del pane: l'indicatore vive sopra al composer, il
#    transcript scorre in alto;
# 2. dopo la frase la riga deve finire quasi subito (una riga di stato chiude
#    con ")" o con un token tipo "· ctrl+t to show todos", non con un discorso);
# 3. niente virgolette prima della frase: se e' citata, e' prosa.
# Nel dubbio si risponde "non occupato": l'errore innocuo e' typeare in un pane
# libero, non restare muti per ore.
busy_scan_lines="${JHT_TMUX_BUSY_SCAN_LINES:-10}"

_pane_busy() {
  local line lower before after rest
  while IFS= read -r line; do
    lower=$(printf '%s' "$line" | tr 'A-Z' 'a-z')
    case "$lower" in
      *"esc to interrupt"*) ;;
      *) continue ;;
    esac
    before="${lower%%esc to interrupt*}"
    after="${lower#*esc to interrupt}"
    # (3) citata → prosa
    case "$before" in
      *\"|*\'|*“|*«) continue ;;
    esac
    # (2) la frase e' seguita da un discorso → prosa. Una riga di stato dopo la
    # frase o CHIUDE subito — ")" e spazi — o continua con un separatore e un
    # altro token di stato ("· ctrl+t to show todos)"). Se invece riprende con
    # una parola ("(esc to interrupt confirmed on each)") e' una frase.
    if [ "${#after}" -gt 40 ]; then
      continue
    fi
    rest=$(printf '%s' "$after" | sed 's/[) ]*$//; s/^ *//')
    case "$rest" in
      "") ;;
      "·"*|"•"*|"|"*|","*|"-"*) ;;
      *) continue ;;
    esac
    return 0
  done <<EOF
$(printf '%s\n' "$1" | tail -n "$busy_scan_lines")
EOF
  return 1
}

# Legacy budget retained for callers/tests; busy no longer gates typing.
busy_budget="${JHT_TMUX_BUSY_WAIT:-90}"

# Il COMPOSER della TUI: dall'ULTIMA riga che inizia col marker di input
# ("❯" su Claude Code/Kimi, "›" su OpenAI Codex, ">" su build piu' vecchie,
# "▌" sul cursore a blocco) fino in fondo al pane. Deve essere l'ultima e non
# la prima: dopo un submit il messaggio resta visibile NEL TRANSCRIPT sopra al
# composer, quindi cercare la signature in tutto il pane direbbe "non
# submittato" anche quando il turno e' partito regolarmente.
#
# Fino in fondo, non la sola riga del marker: Codex manda a capo il testo del
# composer, e la coda del messaggio (la probe) sta sulle righe di
# continuazione. Il marker "›" di Codex mancava: `_composer_line` tornava vuota
# (o una riga del transcript), `_submitted` non vedeva la probe e rispondeva
# "submittato" con il testo ancora nel composer — 27/09, un CAPITANO con
# decine di messaggi incollati e mai inviati, ciascuno dichiarato consegnato.
#
# Il marker puo' essere preceduto dal BORDO del box che alcune TUI disegnano
# ("│ > ..."): senza tollerarlo la riga non viene trovata, `_composer_line`
# torna vuota, `_submitted` non vede la probe e risponde "submittato" — cioe'
# proprio il falso positivo che questo controllo esiste per impedire. Il
# carattere di bordo si accetta come singolo non-alfanumerico opzionale.
# (Recuperato dalla versione dev7 di questa stessa verifica, che nasceva dallo
# stesso guasto e copriva questi due casi in piu'.)
_composer_line() {
  local start
  start=$(printf '%s\n' "$1" \
    | grep -nE '^[[:space:]]*[^[:alnum:][:space:]]?[[:space:]]*(❯|›|>|▌)' \
    | tail -1 | cut -d: -f1 || true)
  [ -n "$start" ] || return 0
  printf '%s\n' "$1" | tail -n "+$start" || true
}

# ── La prova (C2/C3 del 23/10) ─────────────────────────────────────────────────
# Una casella vuota da sola non prova niente: il 21/10 un messaggio e' sparito cosi'
# (i tasti si erano persi, la firma stava gia' nella conversazione sopra, l'Invio e' partito
# su una casella vuota e `_submitted` ha detto «consegnato»). Qui la firma si cerca SOLO
# nella casella, e «preso» ha bisogno di una prova:
#   A. il testo era NELLA casella prima dell'Invio e dopo la casella e' ancora disegnata, vuota di lui;
#   B. il testo non e' piu' nella casella e nella conversazione ha UNA ricorrenza in piu' di prima;
#   C. il pane non era occupato prima dell'Invio, lo e' dopo, e il testo non e' piu' nella casella.
# «Pane occupato» da solo NON e' una prova: un CLI a meta' turno accoda, e il testo puo' essere
# ancora li'.

# Quante volte `$2` compare in `$1` (senza sovrapposizioni).
_occurrences() {
  [ -n "$2" ] || { echo 0; return 0; }
  local rest=${1//"$2"/}
  echo $(( (${#1} - ${#rest}) / ${#2} ))
}

# Il NOSTRO testo e' nella casella: testa o coda della firma, anche se la TUI ha mandato a capo il
# testo (si guarda la casella anche senza gli a capo), oppure il segnaposto di un incolla collassato
# ("Pasted text", "Pasted Content") quando prima non c'era.
_in_composer() {
  local line flat
  line=$(_composer_line "$1")
  [ -n "$line" ] || return 1
  flat=${line//$'\n'/}
  case "$line$flat" in
    *"$signature_tail"*|*"$signature_head"*) return 0 ;;
  esac
  if [ "$placeholder_before" -eq 0 ]; then
    case "$line" in
      *"Pasted text"*|*"pasted text"*|*"Pasted Content"*|*"pasted content"*) return 0 ;;
    esac
  fi
  return 1
}

# Il nostro testo e' in attesa di essere inviato. Di norma e' nella casella; ma un testo LUNGO fa
# scorrere fuori dal pane la riga col marcatore (resta visibile solo la coda, accanto al cursore):
# allora vale la coda della firma negli ultimi righi dello schermo, a patto che sia una ricorrenza
# IN PIU' di prima di digitare (una firma gia' presente nella conversazione non conta).
_text_pending() {
  _in_composer "$1" && return 0
  [ -z "$(_composer_line "$1")" ] || return 1
  [ "$(_occurrences "$1" "$signature_tail")" -gt "$occ_tail_before" ] || return 1
  case "$(printf '%s\n' "$1" | tail -n 4)" in
    *"$signature_tail"*) return 0 ;;
  esac
  return 1
}

# La riga della casella non porta niente dopo il marcatore (a parte i bordi del box). Un menu
# («❯ 1. Yes») o un suggerimento grigio NON sono una casella vuota.
_composer_empty() {
  local line first best m rest
  line=$(_composer_line "$1")
  [ -n "$line" ] || return 1
  first=${line%%$'\n'*}
  best=""
  for m in '❯' '›' '▌' '>'; do
    case "$first" in
      *"$m"*) rest=${first#*"$m"}; [ "${#rest}" -gt "${#best}" ] && best=$rest ;;
    esac
  done
  best=${best//[│┃╎| ]/}
  best=${best//$'\t'/}
  [ -z "$best" ]
}

# Il submit e' PROVATO (A, B o C qui sopra). `$1` e' lo schermo dopo l'Invio.
_submitted() {
  if _text_pending "$1"; then
    return 1
  fi
  # A. casella disegnata, vuota
  if _composer_empty "$1"; then
    return 0
  fi
  # B. senza casella: il testo e' passato nella conversazione (una ricorrenza in piu')
  if [ "$(_occurrences "$1" "$signature_tail")" -gt "$occ_tail_before" ]; then
    return 0
  fi
  # C. il turno e' partito adesso
  if [ "$busy_pre" -eq 0 ] && _pane_busy "$1"; then
    return 0
  fi
  return 1
}

# Il testo e' rimasto appeso nel composer: annotalo dove il Dottore lo cerca,
# cosi' la fase di sblocco (skill `agent-unblock`) sa gia' QUALE pane e'
# ostaggio e di QUALE messaggio, invece di doverlo dedurre dal pane.
# Recuperato dalla versione dev7 di questa correzione: senza, un exit 5 lascia
# il Dottore a indovinare, ed e' l'unica traccia che resta di un messaggio che
# non e' mai partito.
#
# Best-effort per costruzione (`|| true`, python3 opzionale): questo canale
# porta tutto il traffico fra agenti, e un logger che fallisce non deve MAI
# impedire una consegna.
_record_stuck() {
  command -v python3 >/dev/null 2>&1 || return 0
  python3 - "$session" "$message" <<'PYEOF' 2>/dev/null || true
import json, os, sys
from datetime import datetime, timezone
session, msg = sys.argv[1], sys.argv[2]
d = os.path.join(os.environ.get("JHT_HOME") or os.path.expanduser("~/.jht"), "logs")
os.makedirs(d, exist_ok=True)
with open(os.path.join(d, "pending-input.jsonl"), "a") as f:
    f.write(json.dumps({
        "ts": datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z"),
        "session": session, "draft": msg[:4096], "owner": "agent",
        "src": "jht-tmux-send", "reason": "submit_unconfirmed",
    }, ensure_ascii=False) + "\n")
PYEOF
}

# Quanti Enter mandare prima di arrendersi e dichiarare "vivo ma muto" (exit 5).
submit_tries="${JHT_TMUX_SUBMIT_TRIES:-3}"
# Pazienza prima di digitare (mezzi secondi, per veder comparire una casella) e dopo
# (mezzi secondi in piu' al secondo di render, per veder comparire il testo).
composer_polls="${JHT_TMUX_COMPOSER_POLLS:-6}"
render_polls="${JHT_TMUX_RENDER_POLLS:-6}"

# ── C4 · un lock per sessione ────────────────────────────────────────────────
# I programmi che scrivono in un pane sono una ventina (bridge, watchdog, throttle, posta,
# chat…): due scritture insieme si spezzano, o l'Invio dell'una parte con il testo dell'altra.
# Il lock sta DENTRO il trasporto, tenuto dalla prima occhiata allo schermo fino alla
# verifica; cade quando il processo finisce, anche se ucciso (e' un flock sul descrittore 9).
# Senza python3 non si puo' bloccare: si consegna lo stesso, e si dice.
lock_wait="${JHT_TMUX_LOCK_WAIT:-12}"
lock_dir="${JHT_TMUX_LOCK_DIR:-${JHT_HOME:-$HOME/.jht}/locks}"

# tmux senza il descrittore del lock: un server tmux avviato da qui lo terrebbe per sempre.
_tmux() { tmux "$@" 9>&-; }
_pane() { _tmux capture-pane -t "$session" -p 2>/dev/null || true; }

_acquire_session_lock() {
  local name polls=0 max status
  command -v python3 >/dev/null 2>&1 || { echo "jht-tmux-send: senza python3 non posso bloccare la sessione $session" >&2; return 0; }
  name=$(printf '%s' "$session" | tr -c 'A-Za-z0-9_.-' '_')
  mkdir -p "$lock_dir" 2>/dev/null || { echo "jht-tmux-send: non posso creare $lock_dir: consegno senza lock" >&2; return 0; }
  # Il gruppo { …; } 2>/dev/null limita il silenzio all'apertura: `exec 9>>file 2>/dev/null` da solo
  # reindirizzerebbe lo stderr dell'INTERO script per sempre.
  if ! { exec 9>>"$lock_dir/tmux-send-$name.lock"; } 2>/dev/null; then
    echo "jht-tmux-send: non posso aprire il lock di $session: consegno senza lock" >&2
    return 0
  fi
  max=$(( lock_wait * 5 ))
  while :; do
    status=0
    python3 -c 'import fcntl, sys
try:
    fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    sys.exit(11)' 2>/dev/null || status=$?
    case "$status" in
      0) return 0 ;;
      11) ;;
      *) echo "jht-tmux-send: il lock di $session non funziona (python3 rc=$status): consegno senza lock" >&2; return 0 ;;
    esac
    polls=$(( polls + 1 ))
    [ "$polls" -le "$max" ] || return 1
    sleep 0.2
  done
}

if ! _acquire_session_lock; then
  echo "jht-tmux-send: un'altra consegna a $session e' ancora in corso dopo ${lock_wait} s: non ho digitato niente (rc=8)" >&2
  exit 8
fi

# ── C1 · il testo si scrive UNA volta ─────────────────────────────────────────
# Prima si GUARDA lo schermo, poi si digita, una sola volta; se non si vede, non si riscrive e non si
# preme niente. Un Escape parte solo se non c'e' nessuna casella (una finestra modale di primo avvio
# che mangia i tasti, 24/07), mai su un testo «non visto»: puo' fermare un turno appena partito.
pane=$(_pane)
waited=0
while [ -z "$(_composer_line "$pane")" ] && ! _pane_busy "$pane" && [ "$waited" -lt "$composer_polls" ]; do
  sleep 0.5
  waited=$(( waited + 1 ))
  pane=$(_pane)
done
if [ -z "$(_composer_line "$pane")" ] && ! _pane_busy "$pane"; then
  # Nessuna casella: o una finestra modale, o una shell nuda. Un solo Escape (non conferma
  # niente), poi si guarda un'ultima volta. Senza casella non si digita: il testo finirebbe in
  # una shell, o in un modale che lo ingoia.
  _tmux send-keys -t "$session" Escape 2>/dev/null || true
  sleep 1.5
  pane=$(_pane)
  if [ -z "$(_composer_line "$pane")" ] && ! _pane_busy "$pane"; then
    echo "jht-tmux-send: $session non ricettivo (nessuna casella di input a schermo, pane non occupato): non ho digitato" >&2
    exit 3
  fi
fi

# Com'era lo schermo PRIMA: serve a provare, dopo, che qualcosa e' cambiato per merito nostro.
occ_tail_before=$(_occurrences "$pane" "$signature_tail")
busy_before=0
_pane_busy "$pane" && busy_before=1
placeholder_before=0
case "$(_composer_line "$pane")" in
  *"Pasted text"*|*"pasted text"*|*"Pasted Content"*|*"pasted content"*) placeholder_before=1 ;;
esac

# Il nostro testo e' gia' nella casella (una chiamata precedente lo ha digitato e non e' stata vista
# in tempo): non si riscrive, si preme solo l'Invio.
if _in_composer "$pane"; then
  echo "jht-tmux-send: il testo e' gia' nella casella di $session: non lo riscrivo, premo solo l'Invio" >&2
else
  _tmux send-keys -t "$session" -l "$message"
  sleep 1
  seen=0
  poll=0
  while :; do
    pane=$(_pane)
    if _text_pending "$pane"; then seen=1; break; fi
    [ "$poll" -lt "$render_polls" ] || break
    poll=$(( poll + 1 ))
    sleep 0.5
  done
  if [ "$seen" -eq 0 ]; then
    # Digitato una volta, mai comparso nella casella: la TUI non lo ha preso. NON si riscrive e NON si
    # preme niente (un Invio o un Escape su un turno appena partito lo rompono). Resta 3, come sempre:
    # e' l'unico segnale «forse morto» su cui conta il pacing-bridge.
    echo "jht-tmux-send: $session non ricettivo: digitato una volta, mai comparso nella casella (pane non occupato o testo non visto): non ho premuto niente" >&2
    exit 3
  fi
fi

# ── C3 · il submit, con la prova ──────────────────────────────────────────────
for s_try in $(seq 1 "$submit_tries"); do
  sleep 0.3
  # `Space` PRIMA di `Enter`, dal secondo tentativo in poi: una TUI Ink rimasta indietro ignora un
  # Enter "a freddo" (dev7, 29/07; coperto da test_throttle_engine::test_5b). Solo dai ritentativi.
  # Prima di ogni Invio ripetuto (C8) si guarda che nella casella ci sia ancora il NOSTRO testo:
  # se si e' aperta una domanda di permesso, un Invio sceglierebbe l'opzione proposta.
  if [ "$s_try" -gt 1 ]; then
    pane=$(_pane)
    if _submitted "$pane"; then
      echo "jht-tmux-send: ${#message} chars to $session (submit $((s_try - 1)), confermato dopo l'attesa)"
      exit 0
    fi
    if ! _text_pending "$pane"; then
      echo "jht-tmux-send: $session: il testo non e' piu' nella casella e non lo trovo nella conversazione: non premo altro (rc=7)" >&2
      exit 7
    fi
    _tmux send-keys -t "$session" Space
    sleep 0.1
  fi
  busy_pre=0
  _pane_busy "$pane" && busy_pre=1
  _tmux send-keys -t "$session" Enter
  # Kimi: con solo Enter il messaggio puo' restare accodato in pending input fino a fine batch di
  # tool calls; Ctrl-S forza il submit immediato. Innocuo se la TUI ha gia' processato Enter.
  if [ "$provider" = "kimi" ]; then
    sleep 0.2
    _tmux send-keys -t "$session" C-s
  fi
  # Il render Ink dopo un submit non e' istantaneo: leggere troppo presto da' un falso «non submittato».
  sleep 1.2
  pane=$(_pane)
  if _submitted "$pane"; then
    echo "jht-tmux-send: ${#message} chars to $session (submit $s_try)"
    exit 0
  fi
done
# Nessuna prova. Se il testo e' ancora nella casella gli Invio sono stati ingoiati: "vivo ma muto"
# (exit 5: il chiamante deve ritentare, MAI respawnare). Altrimenti il testo e' sparito dalla casella
# ma non c'e' prova che sia stato preso: exit 7, «non so» (il chiamante guarda prima di riscrivere).
if _text_pending "$pane"; then
  _record_stuck
  echo "jht-tmux-send: $session ha accettato il testo ma NON lo ha submittato dopo ${submit_tries} Enter — riga appesa nel composer, agente VIVO ma muto: riprova, NON respawnare" >&2
  exit 5
fi
echo "jht-tmux-send: $session: il testo e' uscito dalla casella ma non c'e' prova che sia stato preso (nessuna ricorrenza in piu' nella conversazione, pane non partito): non so (rc=7)" >&2
exit 7
