#!/usr/bin/env bash
# jht-tmux-send — consegna atomica e VERIFICATA di un messaggio a una
# sessione tmux. Pensato per agent-to-agent via TUI (Claude / Codex / Kimi).
#
# Le TUI "Ink" (Codex, Kimi, Claude Code) non registrano l'Enter se
# arriva prima che il testo sia renderizzato nel prompt: testo e Enter
# vanno inviati in step separati, e il submit deve arrivare DOPO che il
# testo e' effettivamente apparso nel pane.
#
# Schema:
#   0. capture-pane            se la TUI e' a META' TURNO ("esc to interrupt")
#                              NON e' morta: e' VIVA e occupata. Aspetta che
#                              torni idle PRIMA di digitare — non si typea mai
#                              dentro un composer occupato (codex accoda+non
#                              eco-a il testo → la verify fallirebbe a vuoto).
#   1. send -l "$message"      tmux typea il testo carattere per carattere
#   2. sleep 1                 lascia respirare il render Ink
#   3. capture-pane            verifica che la signature sia nel pane
#   4. se NO → retry (fino a 3 volte; la TUI potrebbe stare bootando,
#              avere un modal aperto, o aver perso focus)
#   5. se SI → send Enter      submit del prompt
#   6. capture-pane            VERIFICA che il submit sia avvenuto: il testo
#                              deve essere sparito dal composer, oppure il pane
#                              deve essere passato in stato occupato. Se e'
#                              ancora li', l'Enter e' stato ingoiato: si rimanda
#                              (escalation), e se non parte comunque si esce con
#                              5 — MAI 0. Vedi "vivo ma muto" qui sotto.
#
# ⚠️ "VIVO MA MUTO" (delia 28-30/07, 4 occorrenze in 3 giorni, Capitano incluso).
# Fino al 30/07 lo step 6 non esisteva: bastava vedere il testo nel composer per
# mandare Enter e dichiarare successo (exit 0). Ma esiste uno stato in cui la TUI
# ACCETTA il testo e IGNORA l'Enter — osservato quando un messaggio arriva mentre
# l'agente sta chiudendo un turno lungo: l'input successivo non viene mai
# committato. Risultato: pane vivo, riga appesa nel prompt, agente fermo per ore,
# e un chiamante convinto di aver consegnato. La consegna non e' "aver scritto":
# e' "aver visto partire il turno".
#
# Uso:
#   jht-tmux-send SESSION "[@capitano -> @scout-1] [MSG] ..."
#
# Exit:
#   0 → messaggio consegnato e submittato (submit VERIFICATO)
#   1 → argomenti mancanti
#   2 → sessione inesistente
#   3 → testo mai apparso nel pane E pane NON occupato → TUI irricettiva
#       (probabile bash nudo post-crash / modal bloccato): unico segnale "morto".
#   4 → TUI occupata (turno in corso) oltre il budget d'attesa → agente VIVO:
#       messaggio NON consegnato in sincrono, il chiamante deve RIPROVARE piu'
#       tardi, MAI spawnare un rimpiazzo. "Busy != morto" (vedi
#       docs/internal/postmortems/2026-06-11-overspawn-rootcause.md).
#   5 → testo ACCETTATO nel composer ma submit mai avvenuto dopo N Enter →
#       agente VIVO ma incastrato ("vivo ma muto"). Come rc=4 il chiamante deve
#       RIPROVARE, MAI spawnare un rimpiazzo: il pane non e' morto, ha solo una
#       riga appesa nel prompt. Distinto da 3 apposta — rc=3 e' l'unico che
#       autorizza l'escalation-per-morte (pacing-bridge.py:1493).

set -euo pipefail

if [ $# -lt 2 ]; then
  echo "Usage: jht-tmux-send <session> <message>" >&2
  echo "Esempio: jht-tmux-send SCOUT-1 '[@capitano -> @scout-1] [MSG] Inizia il loop.'" >&2
  exit 1
fi

session="$1"
shift
# Supportiamo sia la forma "quotata" (un solo arg) sia lo splat accidentale
# (piu' arg con spazi) — in quest'ultimo caso ricomponiamo con spazi.
message="$*"

if ! tmux has-session -t "$session" 2>/dev/null; then
  echo "jht-tmux-send: sessione '$session' non esiste" >&2
  exit 2
fi

# Provider attivo: serve a sapere se la TUI di destinazione è Kimi, che
# accoda i messaggi inviati con solo Enter mentre l'agente è in mezzo a
# tool calls in-flight (osservato live: SCOUT-1 con 4 throttle in coda
# non processati). Soluzione: dopo Enter mandiamo anche Ctrl-S, che in
# Kimi forza il submit del prompt corrente. Su Claude/Codex Ctrl-S non
# è atteso, quindi lo aggiungiamo SOLO se active_provider == "kimi".
provider=""
config_path="${JHT_HOME:-$HOME/.jht}/jht.config.json"
if [ -f "$config_path" ] && command -v python3 >/dev/null 2>&1; then
  provider=$(python3 -c "import json,sys
try:
  print(json.load(open(sys.argv[1])).get('active_provider',''))
except Exception:
  pass" "$config_path" 2>/dev/null || true)
fi

# Log strutturato per la UI live: parsa il formato "[@from -> @to] [TYPE] ..."
# e appendix una riga JSONL in $JHT_HOME/logs/messages.jsonl. Il backend
# Next legge questo file per animare il pallino tra i nodi del team chart.
# Fallisce silenziosamente — il logging non deve mai bloccare l'invio.
if command -v python3 >/dev/null 2>&1; then
  python3 - "$session" "$message" <<'PYEOF' 2>/dev/null || true
import json, os, re, sys
from datetime import datetime, timezone
session, msg = sys.argv[1], sys.argv[2]
# 1) formato standard agente→agente: "[@from -> @to] [TYPE] ..."
m = re.match(r'^\s*\[@([a-zA-Z0-9_-]+)\s*->\s*@([a-zA-Z0-9_-]+)\]\s*(?:\[([A-Z]+)\])?', msg)
if m:
    from_, to_, kind = m.group(1), m.group(2), m.group(3) or ""
else:
    # 2a) pacing-bridge: "[BRIDGE PACING] ..." — nodo separato dal Bridge
    #     classico (sentinel) nel team chart. Marcato come from=pacing per
    #     far partire il pallino dal nodo Pacing → Capitano.
    mp = re.match(r'^\s*\[BRIDGE\s+PACING\]', msg)
    if mp:
        from_, to_, kind = "pacing", session.lower(), "PACING"
    # 2b) bridge automatico: "[BRIDGE TICK|FAILURE|ALERT|INFO] ..." → la
    #     destinazione è la session destinataria (passata come argv[1]).
    elif (mb := re.match(r'^\s*\[BRIDGE\s+([A-Z]+)\]', msg)):
        from_, to_, kind = "bridge", session.lower(), mb.group(1)
    else:
        # 3) sentinella autonoma: "[SENTINELLA] ..." o "[SENTINELLA] [TYPE] ..."
        ms = re.match(r'^\s*\[SENTINELLA\]\s*(?:\[([A-Z]+)\])?', msg)
        if ms:
            from_, to_, kind = "sentinella", session.lower(), ms.group(1) or ""
        else:
            from_, to_, kind = "", "", ""
log_dir = os.path.join(os.environ.get("JHT_HOME") or os.path.expanduser("~/.jht"), "logs")
os.makedirs(log_dir, exist_ok=True)
out = {
    "ts": datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z"),
    "session": session,
    "from": from_.lower(),
    "to": to_.lower(),
    "type": kind,
    # Keep preview for backwards compat with older readers, but also persist
    # the FULL message body so the case-studies UI can show what the agents
    # actually said. Cap at 4kB just to bound the log line size.
    "preview": msg[:80],
    "body": msg[:4096],
}
with open(os.path.join(log_dir, "messages.jsonl"), "a") as f:
    f.write(json.dumps(out, ensure_ascii=False) + "\n")
PYEOF
fi

# Signature per la verify: primi 30 char del messaggio. Substring perche'
# le TUI wrappano righe lunghe e il messaggio nel pane puo' essere spezzato
# su piu' righe, rendendo un match full-string impossibile.
signature=$(printf '%s' "$message" | head -c 30)

# Busy-detection: codex / claude / kimi mostrano "esc to interrupt" mentre
# l'agente e' a meta' turno. In quello stato il composer NON eco-a il testo
# digitato → la signature non comparirebbe mai e concluderemmo a torto che la
# TUI e' irricettiva (morta). Un pane occupato e' un agente VIVO: aspettiamo
# che torni idle prima di typeare, MAI typeare dentro un turno in corso.
# Causa radice dell'overspawn 07/06 (docs/internal/postmortems/2026-06-11-overspawn-rootcause.md).
#
# ⚠️ FALSO-OCCUPATO (andris 30/07, seconda volta in un giorno). Fino al 30/07
# questo match era una substring su TUTTO il pane, prosa del transcript inclusa.
# Il Capitano ha scritto nella propria risposta:
#     All three workers are idle at the prompt (no spinner, no "esc to
#     interrupt") — halted as expected.
# e da quel momento OGNI jht-tmux-send verso di lui ha visto il pane occupato,
# atteso 90s e rinunciato con exit 4: 16 tick PACE-GUARD non consegnati, 10 di
# fila. Si e' auto-zittito citando la stringa magica. Un agente puo' e deve
# poter parlare del proprio stato senza diventare irraggiungibile.
#
# Ora si distingue la RIGA DI STATO dalla prosa con tre criteri, tarati su righe
# vere raccolte dalla flotta:
#   ◦ Working (16s • esc to interrupt)                       → STATO   (leone)
#   ● All three workers running (esc to interrupt). Recording…→ prosa (ashley)
#   All three are now running (esc to interrupt confirmed…).  → prosa (ashley)
#   …then confirm esc to interrupt before calling it fixed.   → prosa (delia)
# 1. solo le ultime righe del pane: l'indicatore vive sopra al composer, il
#    transcript scorre in alto;
# 2. dopo la frase la riga deve finire quasi subito (una riga di stato chiude
#    con ")" o con un token tipo "· ctrl+t to show todos", non con un discorso);
# 3. niente virgolette prima della frase: se e' citata, e' prosa.
# Nel dubbio si risponde "non occupato": l'errore innocuo e' typeare in un pane
# libero, non restare muti per ore.
busy_scan_lines="${JHT_TMUX_BUSY_SCAN_LINES:-10}"

_pane_busy() {
  local line lower before after rest
  while IFS= read -r line; do
    lower=$(printf '%s' "$line" | tr 'A-Z' 'a-z')
    case "$lower" in
      *"esc to interrupt"*) ;;
      *) continue ;;
    esac
    before="${lower%%esc to interrupt*}"
    after="${lower#*esc to interrupt}"
    # (3) citata → prosa
    case "$before" in
      *\"|*\'|*“|*«) continue ;;
    esac
    # (2) la frase e' seguita da un discorso → prosa. Una riga di stato dopo la
    # frase o CHIUDE subito — ")" e spazi — o continua con un separatore e un
    # altro token di stato ("· ctrl+t to show todos)"). Se invece riprende con
    # una parola ("(esc to interrupt confirmed on each)") e' una frase.
    if [ "${#after}" -gt 40 ]; then
      continue
    fi
    rest=$(printf '%s' "$after" | sed 's/[) ]*$//; s/^ *//')
    case "$rest" in
      "") ;;
      "·"*|"•"*|"|"*|","*|"-"*) ;;
      *) continue ;;
    esac
    return 0
  done <<EOF
$(printf '%s\n' "$1" | tail -n "$busy_scan_lines")
EOF
  return 1
}

# Quanto attendere che un turno in corso finisca prima di rinunciare (exit 4,
# VIVO). I turni codex lunghi (parsing, edit grossi) durano minuti: budget alto
# abbastanza da cavalcare un turno normale, ma bounded per non bloccare il
# mittente (Capitano) all'infinito. Override via env JHT_TMUX_BUSY_WAIT.
busy_budget="${JHT_TMUX_BUSY_WAIT:-90}"

# Riga corrente del composer: l'ULTIMA che inizia col marker di input della TUI
# ("❯" su Claude Code/Codex/Kimi, ">" su build piu' vecchie, "▌" sul cursore a
# blocco). Deve essere l'ultima e non la prima: dopo un submit il messaggio
# resta visibile NEL TRANSCRIPT sopra al composer, quindi cercare la signature
# in tutto il pane direbbe "non submittato" anche quando il turno e' partito
# regolarmente.
#
# Il marker puo' essere preceduto dal BORDO del box che alcune TUI disegnano
# ("│ > ..."): senza tollerarlo la riga non viene trovata, `_composer_line`
# torna vuota, `_submitted` non vede la probe e risponde "submittato" — cioe'
# proprio il falso positivo che questo controllo esiste per impedire. Il
# carattere di bordo si accetta come singolo non-alfanumerico opzionale.
# (Recuperato dalla versione dev7 di questa stessa verifica, che nasceva dallo
# stesso guasto e copriva questi due casi in piu'.)
_composer_line() {
  printf '%s\n' "$1" \
    | grep -E '^[[:space:]]*[^[:alnum:][:space:]]?[[:space:]]*(❯|>|▌)' \
    | tail -1 || true
}

# Il submit e' avvenuto se il turno e' partito (pane occupato) OPPURE il testo
# non e' piu' nel composer (consumato dall'invio). Conservativo: nel dubbio
# risponde "non submittato" e il chiamante ritenta, che e' l'errore innocuo.
_submitted() {
  if _pane_busy "$1"; then
    return 0
  fi
  local line
  line=$(_composer_line "$1")
  case "$line" in
    *"$submit_probe"*) return 1 ;;
    *) return 0 ;;
  esac
}

# Il testo e' rimasto appeso nel composer: annotalo dove il Dottore lo cerca,
# cosi' la fase di sblocco (skill `agent-unblock`) sa gia' QUALE pane e'
# ostaggio e di QUALE messaggio, invece di doverlo dedurre dal pane.
# Recuperato dalla versione dev7 di questa correzione: senza, un exit 5 lascia
# il Dottore a indovinare, ed e' l'unica traccia che resta di un messaggio che
# non e' mai partito.
#
# Best-effort per costruzione (`|| true`, python3 opzionale): questo canale
# porta tutto il traffico fra agenti, e un logger che fallisce non deve MAI
# impedire una consegna.
_record_stuck() {
  command -v python3 >/dev/null 2>&1 || return 0
  python3 - "$session" "$message" <<'PYEOF' 2>/dev/null || true
import json, os, sys
from datetime import datetime, timezone
session, msg = sys.argv[1], sys.argv[2]
d = os.path.join(os.environ.get("JHT_HOME") or os.path.expanduser("~/.jht"), "logs")
os.makedirs(d, exist_ok=True)
with open(os.path.join(d, "pending-input.jsonl"), "a") as f:
    f.write(json.dumps({
        "ts": datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z"),
        "session": session, "draft": msg[:4096], "owner": "agent",
        "src": "jht-tmux-send", "reason": "submit_unconfirmed",
    }, ensure_ascii=False) + "\n")
PYEOF
}

# Quanti Enter mandare prima di arrendersi e dichiarare "vivo ma muto" (exit 5).
submit_tries="${JHT_TMUX_SUBMIT_TRIES:-3}"

attempts=3
for try in $(seq 1 "$attempts"); do
  pane=$(tmux capture-pane -t "$session" -p 2>/dev/null || true)

  # Se la TUI e' a meta' turno, aspetta l'idle PRIMA di digitare.
  if _pane_busy "$pane"; then
    waited=0
    while [ "$waited" -lt "$busy_budget" ]; do
      sleep 3
      waited=$((waited + 3))
      pane=$(tmux capture-pane -t "$session" -p 2>/dev/null || true)
      _pane_busy "$pane" || break
    done
    if _pane_busy "$pane"; then
      # Ancora occupato dopo tutto il budget → agente VIVO, solo su un turno
      # molto lungo. Segnala VIVO-occupato (exit 4), NON morto (exit 3): il
      # chiamante deve riprovare piu' tardi, mai spawnare un rimpiazzo.
      echo "jht-tmux-send: $session occupato (turno in corso) dopo ${busy_budget}s — VIVO, riprova piu' tardi" >&2
      exit 4
    fi
  fi

  tmux send-keys -t "$session" -l "$message"
  sleep 1
  pane=$(tmux capture-pane -t "$session" -p 2>/dev/null || true)
  # Che cosa cercare nel composer per sapere se il testo e' ancora li'. Il
  # match diretto e' la signature; ma la TUI puo' aver COLLASSATO un paste
  # multi-riga in un placeholder — Claude Code lo chiama "[Pasted text +N
  # lines]", OpenAI Codex "[Pasted Content N chars]" — e in quel caso la
  # signature non comparirebbe mai (senza questi rami l'Enter non verrebbe
  # inviato e il messaggio resterebbe appeso nel composer, con l'agente che non
  # parte mai — onboarding Codex rotto, Leone 24/07). La probe deve essere
  # QUELLO CHE SI VEDE, altrimenti lo step 6 crede sempre di aver submittato.
  submit_probe=""
  case "$pane" in
    *"$signature"*)       submit_probe="$signature" ;;
    *"Pasted text"*)      submit_probe="Pasted text" ;;
    *"pasted text"*)      submit_probe="pasted text" ;;
    *"Pasted Content"*)   submit_probe="Pasted Content" ;;
    *"pasted content"*)   submit_probe="pasted content" ;;
  esac

  if [ -n "$submit_probe" ]; then
    # Il testo è nel buffer di input → submit, POI verifica. Un Enter ingoiato
    # non lascia traccia: l'unica prova che il turno è partito è rileggere il
    # pane. Escalation: fino a submit_tries Enter, poi exit 5 (vivo ma muto).
    for s_try in $(seq 1 "$submit_tries"); do
      sleep 0.3
      # `Space` PRIMA di `Enter`, dal secondo tentativo in poi: una TUI Ink
      # rimasta indietro ignora un Enter "a freddo": non ha nulla da
      # committare finche' un carattere qualunque non la riporta a disegnare
      # il composer. Sequenza verificata sul campo (dev7, 29/07) e coperta da
      # test_throttle_engine::test_5b — senza, la sveglia di un prompt con
      # testo pendente non parte MAI e l'agente resta muto.
      #
      # Solo dai ritentativi: al primo giro il testo e' appena stato digitato,
      # la TUI e' sveglia per definizione, e uno Space in piu' finirebbe in
      # coda al messaggio.
      if [ "$s_try" -gt 1 ]; then
        tmux send-keys -t "$session" Space
        sleep 0.1
      fi
      tmux send-keys -t "$session" Enter
      # Kimi: con solo Enter il messaggio puo' restare accodato in pending
      # input fino a fine batch di tool calls; Ctrl-S forza il submit
      # immediato del prompt. Innocuo se la TUI ha gia' processato Enter.
      if [ "$provider" = "kimi" ]; then
        sleep 0.2
        tmux send-keys -t "$session" C-s
      fi
      # Il render Ink dopo un submit non e' istantaneo: leggere troppo presto
      # produce un falso "non submittato" e un Enter di troppo (che sul prompt
      # ormai vuoto e' innocuo, ma allunga inutilmente).
      sleep 1.2
      pane=$(tmux capture-pane -t "$session" -p 2>/dev/null || true)
      if _submitted "$pane"; then
        echo "jht-tmux-send: ${#message} chars to $session (try $try, submit $s_try)"
        exit 0
      fi
    done
    # Testo accettato, Enter ignorati: e' lo stato "vivo ma muto". NON e' rc=3
    # (quello autorizza il respawn) e non e' rc=0: il chiamante deve ritentare.
    _record_stuck
    echo "jht-tmux-send: $session ha accettato il testo ma NON lo ha submittato dopo ${submit_tries} Enter — riga appesa nel composer, agente VIVO ma muto: riprova, NON respawnare" >&2
    exit 5
  fi
  # Testo perso. Casi: (a) il typing ha fatto partire un turno → il busy-check
  # in cima alla prossima iterazione lo cattura e aspetta; (b) la TUI e' in boot
  # o ha un modal aperto che ha mangiato i keystroke. Pausa e ritenta.
  #
  # Modal di primo avvio che mangia i keystroke (es. Claude Code v2.1.x "Try
  # the new fullscreen renderer?", theme-picker, "what's new", update-prompt):
  # il pane NON e' busy e il testo non compare. Mandiamo Esc — il "cancel"
  # generico che chiude QUALSIASI prompt senza confermarne una scelta (MAI
  # Enter, che selezionerebbe il default: sul fullscreen sarebbe "Yes" → attiva
  # l'alternate screen e rompe capture-pane). Poi il typing riparte alla
  # prossima iterazione. Robusto e future-proof per claude/codex/kimi, a
  # prescindere da quale nuovo prompt introducano (Leone 24/07).
  if ! _pane_busy "$pane"; then
    tmux send-keys -t "$session" Escape 2>/dev/null || true
  fi
  sleep 1.5
done

# Retry esauriti e pane NON occupato → genuinamente irricettivo (bash nudo
# post-crash, modal bloccato): unico vero segnale "forse morto" (exit 3).
echo "jht-tmux-send: $session non ricettivo dopo $attempts tentativi (testo mai apparso, pane non occupato)" >&2
exit 3
