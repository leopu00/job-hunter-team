# Skills the Dottore consumes from agents/_skills/.
# One name per line. Lines starting with `#` and blank lines are ignored.
# The launcher (start-agent.sh) reads this file at boot and copies the
# listed skills into the agent's ~/.claude/skills/ runtime workspace.

# Inter-agent messaging (report al Capitano, kick-off post-respawn)
tmux-send

# Fase 1 del giro (2026-07-29): rilevare e SCIOGLIERE i blocchi del team
# (input pendente, retry-loop, prompt vuoti con quota, coordinatore muto)
agent-unblock

# DB access (recover task context before respawning a crashed agent)
db-query

# Routine round (PRIMARY, 2026-06-13 redesign): context-refresh per session
# (age → capture → analytics → parked-check → interview → synthesis → recreate+resume)
session-refresh

# Zombie rescue (SECONDARY, only when spawned on-demand for a suspected-dead agent)
liveness-check

# Pre-emptive context freshness — superseded by the scheduled session-refresh rounds
daily-restart-wave

# Maintenance (end-of-round only, conditional)
cache-prune
py-tools-audit
cv-disk-audit
