# Skills the Capitano consumes from agents/_skills/.
# One name per line. Lines starting with `#` and blank lines are ignored.
# The launcher (start-agent.sh) reads this file at boot and copies the
# listed skills into the agent's ~/.claude/skills/ runtime workspace.

# Inter-agent + user communication
tmux-send

# Chiusura ordinata quando l'utente esce dall'applicazione: ogni agente
# annota dove era arrivato, poi il flag lascia chiudere il gioco.
graceful-shutdown
chat-web
game-reply-options
# Phone-side outbound: notifiche batch + risposte all'utente sul bot Capitano
telegram-send

# Notifiche utente con fallback Telegram -> dashboard web (batch ready, alert)
notify-user

# C-04 bis IMPONE questa skill per ogni ora comunicata all'utente (Telegram,
# charts, status): l'utente e' CEST/CET e legge "03:11" come ora locale quando
# era UTC. Senza la skill installata la regola rimanda a qualcosa che l'agente
# non ha, e o inventa il formato o lo salta.
format-time

# C-21 IMPONE il diario giornaliero: a ogni risveglio (context-refresh Dottore,
# nuova finestra, reboot) leggi l'handoff di ieri PRIMA di lavorare, altrimenti
# ripeti gli stessi errori di pacing. Un file al giorno.
captain-diary

# Pickup risposte utente arrivate via dashboard web (marker prompt-injection)
user-reply-check

# DB access (read + targeted update; the Captain does NOT insert)
db-query
db-update

# Primo avvio di un utente nuovo: roster completo subito invece della salita
# a gradini, perché il risultato che conta è una posizione CON PUNTEGGIO.
first-run-burst

# Il MANUALE delle modalità del team (search/harvest/care/calibration/saving).
# Il banner orario [MODALITÀ CORRENTE] porta la specifica compatta; quando il
# Capitano non ricorda cosa implica la modalità corrente — quali code
# assegnare, cosa spawnare o fermare, come si compone con C-25 — la risposta
# va LETTA qui prima di decidere, non dedotta da un contesto che un refresh
# può aver azzerato (18 giorni di manutenzione persa, luglio 2026).
team-modes

# Coordination (the Captain's daily operational loop)
spawn-agent
sentinel-orders
bridge-pacing
bridge-mailbox
pipeline-triage
# La velocità della finestra è tornata al Capitano: il pace guard misura e
# CONSIGLIA, il throttle lo scrive lui. La decisione non è "tutti giù del 10%"
# ma QUALE agente rallentare e di QUANTO — chi consuma (share) non è chi
# produce, e livellare colpisce Analista e Scorer, cioè chi trasforma
# l'arretrato in una posizione CON PUNTEGGIO. Include i casi "non fare niente".
throttle-distribution
# Calibrazione graduale del roster: quanti worker + che throttle per centrare
# la velocità-target, con piano a scaglioni (C-02, anti ACCELERARE→marathon).
scaling-calc

# Emergency: spawn fresh DOTTORE on-demand quando serve health-check
# subito (post-mortem 2026-05-18: tra cicli auto il DOTTORE è bash
# residua, scrivergli è inutile, va spawnato ex-novo).
spawn-doctor

# Emergency: agente sospettato BLOCCATO IN LOOP attivo (vivo+ripete senza
# produrre) — crepa fra C-08 (morto) e C-12 (cadenza 0.00). Rileva deterministico
# (capture-pane diff + 0 avanzamento DB) -> Dottore-first -> kill (C-14).
agent-emergency

# Throttle config + on-demand rate-budget probe (rare, for ad-hoc diagnosis)
throttle
# Wake-up ack: first command after every throttle pause. Without it the
# flag stays on NOTIFIED and the watchdog escalates on a healthy agent.
throttle-ack
# The ONLY surface that writes the team's rhythms. The engine re-reads the
# config when it arms each timer, so a change bites on the agent's next cycle
# by itself: never send a number over tmux.
throttle-set
rate-budget
