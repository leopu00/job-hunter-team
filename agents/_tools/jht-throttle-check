#!/usr/bin/env bash
# jht-throttle-check — SHIM di compatibilità: sei ancora in pausa?
#
# ⚠️ Deprecato assieme a `jht-throttle`. Nel disegno nuovo il gate pre-task non
# serve più: non riprendi da solo, ti sveglia il motore. Resta per i prompt che
# ancora aprono l'iterazione con `jht-throttle-check <me> || jht-throttle-wait <me>`.
#
# Interroga `throttle_engine.py check`, che guarda DUE fonti e prende la più
# lontana: il flag del motore (`state/throttle-flags.json`) e il vecchio state
# file per-agente (`state/throttle-<agente>.json`), che `spawn_stagger.py`
# scrive per staggerare un worker appena nato e `stepcap-watchdog.py` per
# metterlo in pausa prima di riprenderlo. Ignorare il secondo vorrebbe dire che
# quei due meccanismi smettono silenziosamente di gatare gli agenti.
#
# Exit code:
#   0 → non sei in pausa, puoi procedere.
#   1 → sei ancora in pausa. Stampa "STILL_THROTTLED ... remaining=Xs" su
#       stderr. Chiudi il turno: la sveglia arriva dal motore.
#   2 → argomenti mancanti.
#
# Nessun side effect, solo lettura. Sicuro chiamare ad alta frequenza.

set -eu

AGENT="${1:-}"
if [ -z "$AGENT" ]; then
  echo "Usage: jht-throttle-check <agent>" >&2
  exit 2
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENGINE="/app/shared/skills/throttle_engine.py"
[ -f "$ENGINE" ] || ENGINE="${SCRIPT_DIR}/../../shared/skills/throttle_engine.py"
if [ ! -f "$ENGINE" ]; then
  # Motore assente: fail-open. Un gate che blocca l'agente perché non riesce a
  # leggere lo stato lo ferma per sempre, ed è il guasto peggiore dei due.
  exit 0
fi

exec python3 "$ENGINE" check "$AGENT"
