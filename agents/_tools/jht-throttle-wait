#!/usr/bin/env bash
# jht-throttle-wait — SHIM di compatibilità: attende la fine di una pausa già
# armata.
#
# ⚠️ Deprecato assieme a `jht-throttle`. Nel disegno nuovo non c'è nulla da
# attendere: il motore possiede il timer e ti sveglia via tmux. Resta per i
# prompt che ancora chiudono il gate pre-task con questo comando.
#
# Differenza sostanziale dal vecchio comportamento: questa attesa è una
# COMODITÀ, non il meccanismo. Se veniamo uccisi a metà, il timer è comunque
# sul disco del motore e la sveglia arriva alla scadenza — è il guasto del
# 2026-07-30 (2h15m di stallo) che non può più ripetersi.
#
# Uso:
#   jht-throttle-wait <agent>
#
# Idempotente: senza una pausa pendente esce subito 0.

set -eu

AGENT="${1:-}"
if [ -z "$AGENT" ]; then
  echo "Usage: jht-throttle-wait <agent>" >&2
  exit 2
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENGINE="/app/shared/skills/throttle_engine.py"
[ -f "$ENGINE" ] || ENGINE="${SCRIPT_DIR}/../../shared/skills/throttle_engine.py"
if [ ! -f "$ENGINE" ]; then
  exit 0
fi

UNTIL="$(python3 "$ENGINE" status "$AGENT" --print until 2>/dev/null || true)"
if [ -z "$UNTIL" ]; then
  exit 0
fi

# Loop bloccante in chunk 15s. Nessun cleanup del flag all'uscita: il flag è del
# motore, e cancellarlo qui era il modo in cui si perdevano i throttle.
trap 'exit 0' INT TERM
while :; do
  NOW=$(date '+%s')
  if [ "$NOW" -ge "$UNTIL" ]; then break; fi
  REMAINING=$(( UNTIL - NOW ))
  CHUNK=15
  if [ "$REMAINING" -lt "$CHUNK" ]; then CHUNK="$REMAINING"; fi
  sleep "$CHUNK"
done

# Attesa completata: firmiamo il risveglio, così il motore non manda una sveglia
# a un agente già ripartito.
python3 "$ENGINE" ack "$AGENT" >/dev/null 2>&1 || true
exit 0
