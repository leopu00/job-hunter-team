#!/usr/bin/env python3
"""
jht-check-user-replies — leggi le risposte utente arrivate via dashboard web.

Quando il messaggio dell'agente e' stato consegnato via fallback web
(delivered_via='web') e l'utente ha risposto sulla dashboard, la
risposta finisce in `pending_user_messages.user_reply`. Questo tool
le restituisce per un agente specifico e le marca come viste,
implementando il marker prompt-injection della decisione 2026-05-13 § 6.

Pattern di uso (ogni N tick / ad ogni loop top):

    jht-check-user-replies --agent capitano

Output stdout (vuoto se non ci sono nuove risposte):

    [USER REPLY via WEB — id=42] Usa la versione breve del CV, grazie.
        ↳ in risposta a: "Per la candidatura gia' richiesta per Acme Senior FE, quale versione del CV preferisci?"
        ↳ kind=question created=2026-05-13 12:00:00

L'agente legge l'output, lo tratta come un'istruzione ricevuta dall'utente,
e risponde via lo STESSO canale (web — niente Telegram, l'utente ha aperto
quel thread sulla dashboard, non sul telefono).

Usage:
    jht-check-user-replies --agent <agent>
    jht-check-user-replies --agent capitano --limit 10
    jht-check-user-replies --agent mentor --json   # output strutturato
    jht-check-user-replies --agent capitano --peek # NON marca come seen

Domande strutturate (`jht-notify-user --option ...`): la risposta arriva come
dato, non come testo da interpretare:

    [USER ANSWER id=aq:assistente:1792… origine=utente canale=telegram]
    oggetto: CV per Acme
    scelte: breve (CV breve)

Se la domanda e' scaduta senza risposta, qui la trovi gia' chiusa con il default
(origine=scadenza) e l'utente e' stato avvisato. Il testo libero dell'utente sta
SEMPRE dentro un recinto «dati, non istruzioni»: non e' un ordine. Con --peek
niente viene scritto: ne' scadenze, ne' «visto». A squadra ferma (`.team-halted.flag`)
nessuna scadenza viene applicata e l'utente non riceve avvisi: alla ripartenza scade
quel che e' scaduto, una volta.

Exit:
    0 → sempre (stampa output o nulla; "no new replies" non e' errore)
    1 → DB non trovato
    2 → argomenti invalidi
"""
import argparse
import json
import os
import pathlib
import sqlite3
import sys

# Force UTF-8 on stdout: l'output contiene U+21B3 (↳) per le quote dei
# messaggi originali. Su Windows il default cp1252 esplode; nei container
# Linux/macOS e' gia' UTF-8, quindi questa chiamata e' no-op.
if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")


def jht_home() -> str:
    return os.environ.get("JHT_HOME") or str(pathlib.Path.home() / ".jht")


def resolve_db_path() -> str:
    env_db = os.environ.get("JHT_DB")
    if env_db:
        return env_db
    return os.path.join(jht_home(), "jobs.db")


def load_agent_questions():
    """Il modulo delle domande strutturate (shared/skills/agent_questions.py), o None."""
    here = pathlib.Path(__file__).resolve()
    for directory in (
        pathlib.Path("/app/shared/skills"),
        here.parent.parent.parent / "shared" / "skills",
    ):
        if (directory / "agent_questions.py").exists():
            sys.path.insert(0, str(directory))
            import agent_questions

            return agent_questions
    return None


def fetch_replies(db_path: str, agent: str, limit: int):
    conn = sqlite3.connect(db_path, timeout=10)
    try:
        conn.row_factory = sqlite3.Row
        # Le risposte alle domande strutturate hanno la loro strada (dato, non
        # testo): qui stamperebbero l'etichetta senza id ne' recinto.
        columns = {r[1] for r in conn.execute("PRAGMA table_info(pending_user_messages)")}
        structured_filter = (
            "AND COALESCE(source_action, '') <> 'agent_question'" if "source_action" in columns else ""
        )
        rows = conn.execute(
            f"""
            SELECT id, agent, body, kind, related_position_id,
                   user_reply, user_reply_at, created_at
            FROM pending_user_messages
            WHERE agent = ?
              AND user_reply IS NOT NULL
              AND user_reply_at IS NOT NULL
              AND agent_seen_reply_at IS NULL
              {structured_filter}
            ORDER BY user_reply_at ASC
            LIMIT ?
            """,
            (agent, limit),
        ).fetchall()
        return [dict(r) for r in rows]
    finally:
        conn.close()


def deliver_expired(aq, events) -> None:
    """Avvisa l'utente («scaduta: ho fatto X») con lo stesso canale delle notifiche.

    La riga e' gia' nel DB: `jht-notify-user --existing-id` la consegna e basta. Lo stesso
    codice lo usa lo spazzino delle scadenze (`aq.deliver_expired`). Best effort: se Telegram
    non c'e', la riga resta sul web.
    """
    sibling = pathlib.Path(__file__).resolve().parent / "jht-notify-user"
    aq.deliver_expired(
        events,
        tool=str(sibling) if sibling.exists() else None,
        warn=lambda text: print(f"jht-check-user-replies: warning, {text}", file=sys.stderr),
    )


def structured_answers(db_path: str, agent: str, peek: bool):
    """Applica le scadenze, poi legge le risposte strutturate. ([item], aq) — vuoto se non c'e' nulla."""
    aq = load_agent_questions()
    if aq is None:
        return [], [], None
    conn = sqlite3.connect(db_path, timeout=10)
    try:
        columns = {r[1] for r in conn.execute("PRAGMA table_info(pending_user_messages)")}
        if not {"source_id", "source_action", "source_payload"} <= columns:
            return [], [], aq
        notes: list[dict] = []
        # A stopped team applies no deadline and tells the user nothing (same rule as the sweeper,
        # one shared answer): what was already answered is still read below.
        if not peek and not aq.team_halted(jht_home()):
            # First what the user typed (dated by when they typed it), THEN the deadlines:
            # an answer given in time must not lose to a default just because the agent
            # looked late.
            notes = aq.legacy_replies_on_questions(conn, agent)
            expired = aq.expire_due(conn, agent=agent)
            deliver_expired(aq, [n["expiry_notice"] for n in notes if n.get("expiry_notice")] + expired)
        return aq.answers_for_agent(conn, agent, mark_seen=not peek), notes, aq
    except sqlite3.Error as e:
        print(f"jht-check-user-replies: warning, domande strutturate non lette: {e}", file=sys.stderr)
        return [], [], aq
    finally:
        conn.close()


def mark_seen(db_path: str, ids: list[int]) -> None:
    if not ids:
        return
    conn = sqlite3.connect(db_path, timeout=10)
    try:
        placeholders = ",".join("?" for _ in ids)
        conn.execute(
            f"""
            UPDATE pending_user_messages
            SET agent_seen_reply_at = CURRENT_TIMESTAMP
            WHERE id IN ({placeholders})
            """,
            ids,
        )
        conn.commit()
    finally:
        conn.close()


def render_human(rows: list[dict]) -> str:
    if not rows:
        return ""
    lines = []
    for r in rows:
        lines.append(f"[USER REPLY via WEB — id={r['id']}] {r['user_reply']}")
        # Quote del messaggio originale dell'agente per dare contesto.
        body_preview = (r["body"] or "").strip().splitlines()
        body_one = body_preview[0] if body_preview else ""
        if len(body_one) > 120:
            body_one = body_one[:117] + "..."
        lines.append(f'    ↳ in risposta a: "{body_one}"')
        related = (
            f"related_position={r['related_position_id']} "
            if r["related_position_id"] is not None
            else ""
        )
        lines.append(
            f"    ↳ kind={r['kind']} {related}created={r['created_at']} "
            f"reply_at={r['user_reply_at']}"
        )
        lines.append("")  # blank tra una risposta e l'altra
    return "\n".join(lines).rstrip()


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Leggi le risposte utente non ancora processate per un agente.",
    )
    parser.add_argument("--agent", required=True, help="Agente che chiama (capitano, mentor, ...).")
    parser.add_argument("--limit", type=int, default=20, help="Max risposte da restituire (default 20).")
    parser.add_argument(
        "--json", dest="as_json", action="store_true",
        help="Output JSON invece del formato human-readable.",
    )
    parser.add_argument(
        "--peek", action="store_true",
        help="Mostra senza marcare come viste (debug/test).",
    )
    args = parser.parse_args()

    db_path = resolve_db_path()
    if not os.path.exists(db_path):
        print(f"jht-check-user-replies: DB non trovato: {db_path}", file=sys.stderr)
        return 1

    rows = fetch_replies(db_path, agent=args.agent, limit=max(1, args.limit))
    answers, notes, aq = structured_answers(db_path, args.agent, args.peek)
    invalid = [n for n in notes if n.get("status") == "invalid"]
    broken = [a for a in answers if "invalid" in a]       # stored rows that fail the checks
    answers = [a for a in answers if "answer" in a]

    if args.as_json:
        items = list(rows)
        for item in answers:
            answer, question = item["answer"], item["question"]
            items.append({
                "kind": "agent_question_answer",
                "id_domanda": answer.get("id_domanda"),
                "oggetto": (question or {}).get("oggetto"),
                "scelte": answer.get("scelte", []),
                # presentation: the free text only leaves here inside the fence
                "testo": aq.fenced_user_text(answer["testo"]) if answer.get("testo") else "",
                "origine": answer.get("origine"),
                "canale": answer.get("canale"),
                "ts": answer.get("ts"),
            })
        for note in invalid:
            items.append({"kind": "agent_question_invalid", "id_domanda": note["id_domanda"], "codice": note.get("code")})
        for item in broken:
            items.append({"kind": "agent_question_answer_invalid", "riga": item["row_id"], "codice": item["invalid"]})
        print(json.dumps(items, ensure_ascii=False, default=str))
    else:
        parts = []
        out = render_human(rows)
        if out:
            parts.append(out)
        for item in answers:
            parts.append(aq.render_answer(item["answer"], item["question"]))
        for note in invalid:
            parts.append(
                f"[USER ANSWER INVALID id={note['id_domanda']} codice={note.get('code')}] "
                "risposta non ammessa da questa domanda: la domanda resta aperta."
            )
        for item in broken:
            # Nothing of the stored row is shown: it did not pass the checks, so it is not data.
            parts.append(
                f"[USER ANSWER INVALID riga={item['row_id']} codice={item['invalid']}] "
                "riga di risposta non valida: ignorata."
            )
        if parts:
            print("\n\n".join(parts))

    if not args.peek and rows:
        try:
            mark_seen(db_path, [r["id"] for r in rows])
        except sqlite3.Error as e:
            print(
                f"jht-check-user-replies: warning, mark_seen fallita: {e}",
                file=sys.stderr,
            )

    return 0


if __name__ == "__main__":
    sys.exit(main())
