#!/usr/bin/env python3
"""
jht-check-user-replies — leggi le risposte utente arrivate via dashboard web.

Quando il messaggio dell'agente e' stato consegnato via fallback web
(delivered_via='web') e l'utente ha risposto sulla dashboard, la
risposta finisce in `pending_user_messages.user_reply`. Questo tool
le restituisce per un agente specifico e le marca come viste,
implementando il marker prompt-injection della decisione 2026-05-13 § 6.

Pattern di uso (ogni N tick / ad ogni loop top):

    jht-check-user-replies --agent capitano

Output stdout (vuoto se non ci sono nuove risposte):

    [USER REPLY via WEB — id=42] Si', procedi con la candidatura.
        ↳ in risposta a: "Trovato Acme Senior FE 88/100. Procedo con apply?"
        ↳ kind=question created=2026-05-13 12:00:00

L'agente legge l'output, lo tratta come un'istruzione ricevuta dall'utente,
e risponde via lo STESSO canale (web — niente Telegram, l'utente ha aperto
quel thread sulla dashboard, non sul telefono).

Usage:
    jht-check-user-replies --agent <agent>
    jht-check-user-replies --agent capitano --limit 10
    jht-check-user-replies --agent mentor --json   # output strutturato
    jht-check-user-replies --agent capitano --peek # NON marca come seen

Exit:
    0 → sempre (stampa output o nulla; "no new replies" non e' errore)
    1 → DB non trovato
    2 → argomenti invalidi
"""
import argparse
import json
import os
import pathlib
import sqlite3
import sys

# Force UTF-8 on stdout: l'output contiene U+21B3 (↳) per le quote dei
# messaggi originali. Su Windows il default cp1252 esplode; nei container
# Linux/macOS e' gia' UTF-8, quindi questa chiamata e' no-op.
if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")


def resolve_db_path() -> str:
    env_db = os.environ.get("JHT_DB")
    if env_db:
        return env_db
    jht_home = os.environ.get("JHT_HOME") or str(pathlib.Path.home() / ".jht")
    return os.path.join(jht_home, "jobs.db")


def fetch_replies(db_path: str, agent: str, limit: int):
    conn = sqlite3.connect(db_path, timeout=10)
    try:
        conn.row_factory = sqlite3.Row
        rows = conn.execute(
            """
            SELECT id, agent, body, kind, related_position_id,
                   user_reply, user_reply_at, created_at
            FROM pending_user_messages
            WHERE agent = ?
              AND user_reply IS NOT NULL
              AND user_reply_at IS NOT NULL
              AND agent_seen_reply_at IS NULL
            ORDER BY user_reply_at ASC
            LIMIT ?
            """,
            (agent, limit),
        ).fetchall()
        return [dict(r) for r in rows]
    finally:
        conn.close()


def mark_seen(db_path: str, ids: list[int]) -> None:
    if not ids:
        return
    conn = sqlite3.connect(db_path, timeout=10)
    try:
        placeholders = ",".join("?" for _ in ids)
        conn.execute(
            f"""
            UPDATE pending_user_messages
            SET agent_seen_reply_at = CURRENT_TIMESTAMP
            WHERE id IN ({placeholders})
            """,
            ids,
        )
        conn.commit()
    finally:
        conn.close()


def render_human(rows: list[dict]) -> str:
    if not rows:
        return ""
    lines = []
    for r in rows:
        lines.append(f"[USER REPLY via WEB — id={r['id']}] {r['user_reply']}")
        # Quote del messaggio originale dell'agente per dare contesto.
        body_preview = (r["body"] or "").strip().splitlines()
        body_one = body_preview[0] if body_preview else ""
        if len(body_one) > 120:
            body_one = body_one[:117] + "..."
        lines.append(f'    ↳ in risposta a: "{body_one}"')
        related = (
            f"related_position={r['related_position_id']} "
            if r["related_position_id"] is not None
            else ""
        )
        lines.append(
            f"    ↳ kind={r['kind']} {related}created={r['created_at']} "
            f"reply_at={r['user_reply_at']}"
        )
        lines.append("")  # blank tra una risposta e l'altra
    return "\n".join(lines).rstrip()


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Leggi le risposte utente non ancora processate per un agente.",
    )
    parser.add_argument("--agent", required=True, help="Agente che chiama (capitano, mentor, ...).")
    parser.add_argument("--limit", type=int, default=20, help="Max risposte da restituire (default 20).")
    parser.add_argument(
        "--json", dest="as_json", action="store_true",
        help="Output JSON invece del formato human-readable.",
    )
    parser.add_argument(
        "--peek", action="store_true",
        help="Mostra senza marcare come viste (debug/test).",
    )
    args = parser.parse_args()

    db_path = resolve_db_path()
    if not os.path.exists(db_path):
        print(f"jht-check-user-replies: DB non trovato: {db_path}", file=sys.stderr)
        return 1

    rows = fetch_replies(db_path, agent=args.agent, limit=max(1, args.limit))

    if args.as_json:
        print(json.dumps(rows, ensure_ascii=False, default=str))
    else:
        out = render_human(rows)
        if out:
            print(out)

    if not args.peek and rows:
        try:
            mark_seen(db_path, [r["id"] for r in rows])
        except sqlite3.Error as e:
            print(
                f"jht-check-user-replies: warning, mark_seen fallita: {e}",
                file=sys.stderr,
            )

    return 0


if __name__ == "__main__":
    sys.exit(main())
