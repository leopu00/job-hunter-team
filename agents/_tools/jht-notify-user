#!/usr/bin/env python3
"""
jht-notify-user — invia una notifica all'utente con fallback automatico.

Il tool prima registra il messaggio in `pending_user_messages` (jobs.db), poi
tenta la consegna su Telegram via `jht-telegram-send`. Se Telegram riesce,
aggiorna `delivered_via='telegram'`; se fallisce o non e' configurato, lascia
`delivered_via='web'` e il messaggio verra' presentato sulla dashboard web
dopo `jht cloud push` (decisione 2026-05-13).

Usage:
    jht-notify-user --agent capitano "trovate 10 offerte sopra 75/100"
    jht-notify-user --agent mentor --kind digest "Settimana 19: ..."
    jht-notify-user --agent capitano --position-id 42 "candidatura pronta"
    jht-notify-user --agent assistente --kind question "vuoi che procedi con apply?"

Exit:
    0 → riga inserita in DB; consegna Telegram opzionale (best-effort)
    1 → argomenti invalidi
    2 → errore DB (insert fallita)

Output: stampa l'id della riga su stdout (utile per follow-up via cloud sync).
"""
import argparse
import importlib.util
import os
import pathlib
import subprocess
import sqlite3
import sys


def resolve_db_path() -> str:
    env_db = os.environ.get("JHT_DB")
    if env_db:
        return env_db
    jht_home = os.environ.get("JHT_HOME") or str(pathlib.Path.home() / ".jht")
    return os.path.join(jht_home, "jobs.db")


def interpret_escapes(text: str) -> str:
    """Converte le escape letterali \\n \\t \\r in caratteri veri.

    Gli agenti (LLM) scrivono `\\n\\n` come separatore di paragrafi in una
    stringa singola, confidando che venga interpretato. `jht-telegram-send`
    fa gia' questa conversione (vedi commento li', screenshot 2026-05-16);
    senza la stessa conversione qui il body finiva in pending_user_messages
    — e quindi in dashboard — coi 4 caratteri letterali `\\`, `n`, `\\`, `n`.
    Interpretiamo solo le escape comuni, mai un decode generico fragile.
    """
    return text.replace("\\n", "\n").replace("\\t", "\t").replace("\\r", "\r")


def _is_off_hours() -> bool:
    """True se la config ha working_hours e l'orario corrente e' fuori finestra.

    Failsafe: qualsiasi errore di caricamento / parsing → False (assume 24/7).
    Cosi' un working_hours.py mancante o un config malformato non zittisce
    la consegna Telegram per sempre.

    Decisione 2026-05-13 (bot-telegram.md § 9): "fuori finestra il team e' in
    pausa e non manda nulla" → niente push Telegram, la riga resta in
    pending_user_messages con delivered_via='web' e l'utente la trova in
    dashboard al ritorno.
    """
    try:
        # Container: /app/shared/skills/. Dev/host: <repo>/shared/skills/.
        here = pathlib.Path(__file__).resolve()
        candidates = [
            pathlib.Path("/app/shared/skills/working_hours.py"),
            here.parent.parent.parent / "shared" / "skills" / "working_hours.py",
        ]
        wh_path = next((p for p in candidates if p.exists()), None)
        if wh_path is None:
            return False
        spec = importlib.util.spec_from_file_location("_wh", str(wh_path))
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return not mod.is_within_working_hours()
    except Exception:
        return False


# I tre ruoli che hanno un bot Telegram loro (schema 2026-05-13 rev2). Chi
# notifica non e' per forza uno di questi — Scout, Analista, Scorer e gli altri
# notificano l'utente e un bot non ce l'hanno — e per loro il canale resta
# quello dell'Assistente, che e' l'interlocutore generale.
BOT_ROLES = ("assistente", "capitano", "mentor")
DEFAULT_BOT_ROLE = "assistente"


def bot_role_for(agent: str) -> str:
    """Il bot da cui esce il messaggio di questo agente.

    Chi non ha un bot suo parla da quello dell'Assistente: e' il
    comportamento che c'era gia', ma per scelta e non per omissione. Passare
    `--from scout` farebbe uscire `jht-telegram-send` con exit 1, cioe'
    trasformerebbe un'attribuzione sbagliata in un messaggio non consegnato.
    """
    role = (agent or "").strip().lower()
    return role if role in BOT_ROLES else DEFAULT_BOT_ROLE


def try_telegram(agent: str, body: str) -> bool:
    """Best-effort send via jht-telegram-send. Return True on exit 0.

    ⚠️ `--from` non c'era: il ruolo veniva passato solo in `JHT_NOTIFY_AGENT`,
    che `jht-telegram-send` non leggeva. Il ruolo restava quello di default e
    OGNI agente scriveva dal bot dell'Assistente — l'utente ha scritto tre
    volte al Mentor credendo che non rispondesse, e il registro invii dice
    `from=assistente` sullo stesso secondo in cui il DB dice `agent=mentor`
    (O-96). Il canale sbagliato non e' un dettaglio di etichetta: e' la
    conversazione sbagliata.
    """
    cmd = ["jht-telegram-send", "--from", bot_role_for(agent), body]
    try:
        # Timeout corto: il bridge accetta o rifiuta entro pochi secondi.
        # Se la rete e' giu', meglio fallback su web subito che bloccare il loop agente.
        result = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=25,
            env={**os.environ, "JHT_NOTIFY_AGENT": agent},
        )
        return result.returncode == 0
    except FileNotFoundError:
        # jht-telegram-send non in PATH (dev fuori container)
        return False
    except subprocess.TimeoutExpired:
        return False
    except Exception:
        return False


def insert_pending(
    db_path: str,
    agent: str,
    body: str,
    kind: str,
    related_position_id: int | None,
) -> int:
    conn = sqlite3.connect(db_path, timeout=10)
    try:
        conn.execute("PRAGMA foreign_keys=ON")
        cur = conn.execute(
            """
            INSERT INTO pending_user_messages (agent, body, kind, related_position_id)
            VALUES (?, ?, ?, ?)
            """,
            (agent, body, kind, related_position_id),
        )
        conn.commit()
        return cur.lastrowid
    finally:
        conn.close()


def mark_delivered(db_path: str, row_id: int, via: str) -> None:
    conn = sqlite3.connect(db_path, timeout=10)
    try:
        conn.execute(
            """
            UPDATE pending_user_messages
            SET delivered_via = ?,
                delivered_at = CURRENT_TIMESTAMP
            WHERE id = ?
            """,
            (via, row_id),
        )
        conn.commit()
    finally:
        conn.close()


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Notifica utente con fallback Telegram -> dashboard web.",
    )
    parser.add_argument(
        "--agent",
        required=True,
        help="Agente che notifica (es. capitano, mentor, assistente).",
    )
    parser.add_argument(
        "--kind",
        default="notification",
        choices=["notification", "question", "digest", "alert"],
        help="Tipo di messaggio (default: notification).",
    )
    parser.add_argument(
        "--position-id",
        type=int,
        default=None,
        help="ID offerta correlata (opzionale, FK su positions).",
    )
    parser.add_argument(
        "--no-telegram",
        action="store_true",
        help="Salta il tentativo Telegram, scrivi direttamente su web.",
    )
    parser.add_argument("body", help="Testo del messaggio (quotalo).")
    args = parser.parse_args()

    if not args.body.strip():
        print("jht-notify-user: body vuoto", file=sys.stderr)
        return 1

    # Normalizza una sola volta: il body interpretato finisce sia in DB
    # (e quindi in dashboard web via cloud push) sia in Telegram, coerente.
    body = interpret_escapes(args.body)

    db_path = resolve_db_path()
    if not os.path.exists(db_path):
        print(f"jht-notify-user: DB non trovato: {db_path}", file=sys.stderr)
        return 2

    try:
        row_id = insert_pending(
            db_path,
            agent=args.agent,
            body=body,
            kind=args.kind,
            related_position_id=args.position_id,
        )
    except sqlite3.Error as e:
        print(f"jht-notify-user: insert fallita: {e}", file=sys.stderr)
        return 2

    delivered_via = "web"
    off_hours = _is_off_hours()
    if not args.no_telegram and not off_hours and try_telegram(args.agent, body):
        delivered_via = "telegram"
    if off_hours:
        print(
            f"jht-notify-user: off-hours, push Telegram saltato (id={row_id}, "
            f"delivered_via=web)", file=sys.stderr,
        )

    try:
        mark_delivered(db_path, row_id, delivered_via)
    except sqlite3.Error as e:
        # Riga c'e', solo l'update di stato e' fallito. Non e' fatale —
        # un retry potra' riprenderla. Log e prosegui con exit 0.
        print(
            f"jht-notify-user: warning, mark_delivered fallita (id={row_id}): {e}",
            file=sys.stderr,
        )

    # Stampa l'id su stdout per pipeline / debug.
    print(f"{row_id} via={delivered_via}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
