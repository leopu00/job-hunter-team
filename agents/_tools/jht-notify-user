#!/usr/bin/env python3
"""
jht-notify-user — invia una notifica all'utente con fallback automatico.

Il tool prima registra il messaggio in `pending_user_messages` (jobs.db), poi
tenta la consegna su Telegram via `jht-telegram-send`. Se Telegram riesce,
aggiorna `delivered_via='telegram'`; se fallisce o non e' configurato, lascia
`delivered_via='web'` e il messaggio verra' presentato sulla dashboard web
dopo `jht cloud push` (decisione 2026-05-13).

Usage:
    jht-notify-user --agent capitano "trovate 10 offerte sopra 75/100"
    jht-notify-user --agent mentor --kind digest "Settimana 19: ..."
    jht-notify-user --agent capitano --position-id 42 "candidatura pronta"
    jht-notify-user --agent assistente --kind question "vuoi che procedi con apply?"

Domanda strutturata (opzioni da toccare, scadenza, risposta come dato):
    jht-notify-user --agent assistente --oggetto "CV per Acme" \
        --option breve="CV breve" --option lungo="CV completo" \
        --scade-tra 6h "Quale versione del CV uso?"
  Esce subito (non aspetta): l'id della domanda e' l'ultima parola dell'output.
  La risposta si legge con `jht-check-user-replies`. Con --scade-tra il codice
  aggiunge l'opzione «Rinvia, non fare niente», che e' anche il default se
  l'utente non risponde. Altri flag: --tipo, --multipla, --libera.

Testo con «$» (prezzi, variabili): tra virgolette doppie la shell mangia «$1», «$2»
(«$20» diventa «0») prima che il tool lo veda. Metti il testo tra apici singoli, oppure
passalo da stdin con «-» e un heredoc dal delimitatore tra apici:
    jht-notify-user --agent capitano - <<'TXT'
    Plus — $20/month; Pro — $100/month
    TXT

Exit:
    0 → riga inserita in DB; consegna Telegram opzionale (best-effort)
    1 → argomenti invalidi
    2 → errore DB (insert fallita)

Output: stampa l'id della riga su stdout (utile per follow-up via cloud sync).
"""
import argparse
import importlib.util
import json
import os
import pathlib
import re
import subprocess
import sqlite3
import sys


def resolve_db_path() -> str:
    env_db = os.environ.get("JHT_DB")
    if env_db:
        return env_db
    jht_home = os.environ.get("JHT_HOME") or str(pathlib.Path.home() / ".jht")
    return os.path.join(jht_home, "jobs.db")


def interpret_escapes(text: str) -> str:
    """Converte le escape letterali \\n \\t \\r in caratteri veri.

    Gli agenti (LLM) scrivono `\\n\\n` come separatore di paragrafi in una
    stringa singola, confidando che venga interpretato. `jht-telegram-send`
    fa gia' questa conversione (vedi commento li', screenshot 2026-05-16);
    senza la stessa conversione qui il body finiva in pending_user_messages
    — e quindi in dashboard — coi 4 caratteri letterali `\\`, `n`, `\\`, `n`.
    Interpretiamo solo le escape comuni, mai un decode generico fragile.
    """
    return text.replace("\\n", "\n").replace("\\t", "\t").replace("\\r", "\r")


def load_agent_questions():
    """Il modulo delle domande strutturate (shared/skills/agent_questions.py), o None."""
    here = pathlib.Path(__file__).resolve()
    for directory in (
        pathlib.Path("/app/shared/skills"),
        here.parent.parent.parent / "shared" / "skills",
    ):
        if (directory / "agent_questions.py").exists():
            sys.path.insert(0, str(directory))
            import agent_questions

            return agent_questions
    return None


def parse_option_specs(specs: list[str]) -> list[dict]:
    """`--option id=Etichetta` -> {"id", "label"}. ValueError se manca il «=»."""
    options = []
    for spec in specs:
        option_id, sep, label = spec.partition("=")
        if not sep:
            raise ValueError(f"--option vuole id=etichetta, non {spec!r}")
        options.append({"id": option_id.strip(), "label": label})
    return options


def _is_off_hours() -> bool:
    """True se la config ha working_hours e l'orario corrente e' fuori finestra.

    Failsafe: qualsiasi errore di caricamento / parsing → False (assume 24/7).
    Cosi' un working_hours.py mancante o un config malformato non zittisce
    la consegna Telegram per sempre.

    Decisione 2026-05-13 (bot-telegram.md § 9): "fuori finestra il team e' in
    pausa e non manda nulla" → niente push Telegram, la riga resta in
    pending_user_messages con delivered_via='web' e l'utente la trova in
    dashboard al ritorno.
    """
    try:
        # Container: /app/shared/skills/. Dev/host: <repo>/shared/skills/.
        here = pathlib.Path(__file__).resolve()
        candidates = [
            pathlib.Path("/app/shared/skills/working_hours.py"),
            here.parent.parent.parent / "shared" / "skills" / "working_hours.py",
        ]
        wh_path = next((p for p in candidates if p.exists()), None)
        if wh_path is None:
            return False
        spec = importlib.util.spec_from_file_location("_wh", str(wh_path))
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return not mod.is_within_working_hours()
    except Exception:
        return False


# I tre ruoli che hanno un bot Telegram loro (schema 2026-05-13 rev2). Chi
# notifica non e' per forza uno di questi — Scout, Analista, Scorer e gli altri
# notificano l'utente e un bot non ce l'hanno — e per loro il canale resta
# quello dell'Assistente, che e' l'interlocutore generale.
BOT_ROLES = ("assistente", "capitano", "mentor")
DEFAULT_BOT_ROLE = "assistente"


def bot_role_for(agent: str) -> str:
    """Il bot da cui esce il messaggio di questo agente.

    Chi non ha un bot suo parla da quello dell'Assistente: e' il
    comportamento che c'era gia', ma per scelta e non per omissione. Passare
    `--from scout` farebbe uscire `jht-telegram-send` con exit 1, cioe'
    trasformerebbe un'attribuzione sbagliata in un messaggio non consegnato.
    """
    role = (agent or "").strip().lower()
    return role if role in BOT_ROLES else DEFAULT_BOT_ROLE


def try_telegram(
    agent: str, body: str, row_id: int | None = None, kind: str = "notification", buttons: dict | None = None
) -> bool:
    """Best-effort send via jht-telegram-send. Return True on exit 0.

    ⚠️ `--from` non c'era: il ruolo veniva passato solo in `JHT_NOTIFY_AGENT`,
    che `jht-telegram-send` non leggeva. Il ruolo restava quello di default e
    OGNI agente scriveva dal bot dell'Assistente — l'utente ha scritto tre
    volte al Mentor credendo che non rispondesse, e il registro invii dice
    `from=assistente` sullo stesso secondo in cui il DB dice `agent=mentor`
    (O-96). Il canale sbagliato non e' un dettaglio di etichetta: e' la
    conversazione sbagliata.
    """
    cmd = ["jht-telegram-send", "--from", bot_role_for(agent), body]
    if buttons:
        # The buttons of a single-choice question; the numbered options stay in the text.
        cmd = ["jht-telegram-send", "--from", bot_role_for(agent), "--inline-buttons",
               json.dumps(buttons, ensure_ascii=False, separators=(",", ":")), body]
    try:
        # Timeout corto: il bridge accetta o rifiuta entro pochi secondi.
        # Se la rete e' giu', meglio fallback su web subito che bloccare il loop agente.
        result = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=25,
            # `JHT_MESSAGE_ROW_ID` dice al mittente che la cronologia per
            # questo messaggio esiste gia': senza, dalla sua conservazione
            # (O-100) uscirebbe una seconda riga identica.
            env={
                **os.environ,
                "JHT_NOTIFY_AGENT": agent,
                "JHT_MESSAGE_KIND": kind,
                **({"JHT_MESSAGE_ROW_ID": str(row_id)} if row_id else {}),
            },
        )
        return result.returncode == 0
    except FileNotFoundError:
        # jht-telegram-send non in PATH (dev fuori container)
        return False
    except subprocess.TimeoutExpired:
        return False
    except Exception:
        return False


def insert_pending(
    db_path: str,
    agent: str,
    body: str,
    kind: str,
    related_position_id: int | None,
    source_id: str | None = None,
    source_action: str | None = None,
    source_payload: str | None = None,
) -> tuple[int, bool]:
    conn = sqlite3.connect(db_path, timeout=10)
    try:
        conn.execute("PRAGMA foreign_keys=ON")
        if source_id:
            existing = conn.execute(
                "SELECT id, agent, body, kind, related_position_id, source_action, source_payload "
                "FROM pending_user_messages WHERE source_id = ?",
                (source_id,),
            ).fetchone()
            if existing:
                expected = (
                    agent,
                    body,
                    kind,
                    related_position_id,
                    source_action,
                    source_payload,
                )
                if existing[1:] != expected:
                    raise ValueError("source-id collision with different notification data")
                return int(existing[0]), False
        cur = conn.execute(
            """
            INSERT INTO pending_user_messages (
                agent, body, kind, related_position_id,
                source_id, source_action, source_payload
            ) VALUES (?, ?, ?, ?, ?, ?, ?)
            """,
            (
                agent,
                body,
                kind,
                related_position_id,
                source_id,
                source_action,
                source_payload,
            ),
        )
        conn.commit()
        return int(cur.lastrowid), True
    finally:
        conn.close()


def mark_delivered(db_path: str, row_id: int, via: str) -> None:
    conn = sqlite3.connect(db_path, timeout=10)
    try:
        conn.execute(
            """
            UPDATE pending_user_messages
            SET delivered_via = ?,
                delivered_at = CURRENT_TIMESTAMP
            WHERE id = ?
            """,
            (via, row_id),
        )
        conn.commit()
    finally:
        conn.close()


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Notifica utente con fallback Telegram -> dashboard web.",
    )
    parser.add_argument(
        "--agent",
        required=True,
        help="Agente che notifica (es. capitano, mentor, assistente).",
    )
    parser.add_argument(
        "--kind",
        default=None,
        choices=["notification", "question", "digest", "alert"],
        help="Tipo di messaggio (default: notification).",
    )
    parser.add_argument(
        "--position-id",
        type=int,
        default=None,
        help="ID offerta correlata (opzionale, FK su positions).",
    )
    parser.add_argument(
        "--no-telegram",
        action="store_true",
        help="Salta il tentativo Telegram, scrivi direttamente su web.",
    )
    parser.add_argument(
        "--existing-id",
        type=int,
        help="Deliver a row already persisted by the caller instead of inserting it.",
    )
    parser.add_argument("--source-id", help="Stable idempotency key (optional).")
    parser.add_argument("--source-action", help="Structured action name (optional).")
    parser.add_argument("--source-payload", help="Structured JSON payload (optional).")
    parser.add_argument(
        "--option", action="append", default=[], metavar="ID=ETICHETTA",
        help="Domanda strutturata: un'opzione da toccare (ripetibile, 2-8).",
    )
    parser.add_argument("--oggetto", help="Domanda strutturata: titolo breve (obbligatorio con --option).")
    parser.add_argument(
        "--tipo", choices=["urgente", "blocco", "domanda", "completamento", "comunicazione"],
        help="Domanda strutturata: tipo (default: domanda).",
    )
    parser.add_argument("--multipla", action="store_true", help="Domanda strutturata: si puo' scegliere piu' di un'opzione.")
    parser.add_argument("--libera", action="store_true", help="Domanda strutturata: l'utente puo' aggiungere testo libero.")
    parser.add_argument(
        "--scade-tra", metavar="DURATA",
        help="Domanda strutturata: scadenza (es. 30m, 6h, 2d; da 5 minuti a 7 giorni). Alla scadenza vale «Rinvia».",
    )
    parser.add_argument(
        "body",
        help="Testo del messaggio, tra apici singoli (tra doppi la shell mangia $1, $2); «-» lo legge da stdin.",
    )
    args = parser.parse_args()
    if args.body == "-":
        # the newline a heredoc ends with is not part of the text
        args.body = sys.stdin.read().removesuffix("\n")
    structured = bool(
        args.option or args.oggetto or args.tipo or args.multipla or args.libera or args.scade_tra
    )
    if not structured and args.kind is None:
        args.kind = "notification"

    if not args.body.strip():
        print("jht-notify-user: body vuoto", file=sys.stderr)
        return 1
    if args.existing_id is not None and args.existing_id <= 0:
        print("jht-notify-user: invalid existing-id", file=sys.stderr)
        return 1
    if args.source_id and not re.fullmatch(r"[A-Za-z0-9_.:-]{1,180}", args.source_id):
        print("jht-notify-user: invalid source-id", file=sys.stderr)
        return 1
    if args.source_action and not re.fullmatch(r"[a-z0-9_]{1,80}", args.source_action):
        print("jht-notify-user: invalid source-action", file=sys.stderr)
        return 1
    if bool(args.source_action) != bool(args.source_payload) or bool(args.source_id) != bool(args.source_action):
        print("jht-notify-user: source metadata incompleti", file=sys.stderr)
        return 1
    if args.source_payload:
        try:
            decoded_payload = json.loads(args.source_payload)
        except (TypeError, ValueError):
            print("jht-notify-user: source-payload non e JSON valido", file=sys.stderr)
            return 1
        if not isinstance(decoded_payload, dict) or len(args.source_payload) > 16_000:
            print("jht-notify-user: invalid source-payload", file=sys.stderr)
            return 1

    # Normalizza una sola volta: il body interpretato finisce sia in DB
    # (e quindi in dashboard web via cloud push) sia in Telegram, coerente.
    body = interpret_escapes(args.body)

    question = None
    if structured:
        # Una domanda strutturata decide da sola kind e metadati: chi li passa a
        # mano la sta aggirando, e il contratto non si puo' verificare.
        if args.kind is not None or args.source_id or args.source_action or args.source_payload \
                or args.existing_id is not None:
            print(
                "jht-notify-user: --option non si combina con --kind, --source-* ne' --existing-id",
                file=sys.stderr,
            )
            return 1
        aq = load_agent_questions()
        if aq is None:
            print("jht-notify-user: modulo domande strutturate non trovato", file=sys.stderr)
            return 1
        try:
            question = aq.build_question(
                agent=args.agent,
                testo=body,
                oggetto=args.oggetto or "",
                opzioni=parse_option_specs(args.option),
                tipo=args.tipo or "domanda",
                multipla=args.multipla,
                libera=args.libera,
                scade_tra=args.scade_tra,
                related_position_id=args.position_id,
            )
        except (aq.QuestionRejected, ValueError) as error:
            print(f"jht-notify-user: domanda non valida: {error}", file=sys.stderr)
            return 1
        body = question.body
        args.kind = question.kind
        args.source_id = question.source_id
        args.source_action = aq.SOURCE_ACTION
        args.source_payload = question.payload_json

    db_path = resolve_db_path()
    if not os.path.exists(db_path):
        print(f"jht-notify-user: DB non trovato: {db_path}", file=sys.stderr)
        return 2

    try:
        row_id, created = insert_pending(
            db_path,
            agent=args.agent,
            body=body,
            kind=args.kind,
            related_position_id=args.position_id,
            source_id=args.source_id,
            source_action=args.source_action,
            source_payload=args.source_payload,
        )
        if args.existing_id is not None and row_id != args.existing_id:
            raise ValueError("existing-id does not match the durable notification")
    except (sqlite3.Error, ValueError) as e:
        print(f"jht-notify-user: insert fallita: {e}", file=sys.stderr)
        return 2

    delivered_via = "web"
    # A CLOSER question about an application the user authorised is an answer
    # the user is waiting for, not a notification to hold for working hours;
    # a login verification code expires in minutes.
    # Held, it was consumed on the web and never reached Telegram: its source
    # id counted it as asked, so no later round delivered it (13/09).
    # The CLOSER's round summary is the outcome of those same applications:
    # held for working hours it stayed on the web (14/09, after patch 21).
    off_hours = args.source_action not in (
        "closer_application_answer", "closer_login_code", "closer_digest",
        # Chi ha una domanda con scadenza in corso la sta aspettando.
        "agent_question", "agent_question_expired",
        # Un'azione presa dal sito con la sessione dell'utente: se non e' stato
        # lui, deve saperlo prima che il box la esegua, non domattina.
        "web_action_notice",
        # The box can no longer reach the website: a row held for the web would
        # never be seen there, since that is exactly what does not sync.
        "cloud_sync_notice",
    ) and _is_off_hours()
    should_deliver = created or args.existing_id is not None
    if should_deliver and (
        not args.no_telegram
        and not off_hours
        and try_telegram(
            args.agent, body, row_id, args.kind,
            aq.inline_keyboard(question.source_id, question.payload) if question is not None else None,
        )
    ):
        delivered_via = "telegram"
    if should_deliver and off_hours:
        print(
            f"jht-notify-user: off-hours, push Telegram saltato (id={row_id}, "
            f"delivered_via=web)", file=sys.stderr,
        )

    try:
        if should_deliver:
            mark_delivered(db_path, row_id, delivered_via)
    except sqlite3.Error as e:
        # Riga c'e', solo l'update di stato e' fallito. Non e' fatale —
        # un retry potra' riprenderla. Log e prosegui con exit 0.
        print(
            f"jht-notify-user: warning, mark_delivered fallita (id={row_id}): {e}",
            file=sys.stderr,
        )

    # Stampa l'id su stdout per pipeline / debug.
    if question is not None:
        print(f"{row_id} via={delivered_via} id={question.source_id}")
    else:
        print(f"{row_id} via={delivered_via}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
