#!/usr/bin/env bash
# jht-install — UN comando per installare deps nella lane STANDARD giusta,
# così gli agenti hanno libertà totale MA i deps NON si sparpagliano per
# cartelle diverse (il "caos deps" del redesign Mantenitore 2026-06-13).
#
# Le 4 lane usano i meccanismi GIÀ esistenti nell'immagine (non ne aggiunge
# di nuovi):
#   apt      → NON disponibile: il container non ha sudo (P1 del 08/10). I
#              pacchetti di SISTEMA stanno nell'immagine; uno che manca si
#              chiede al Capitano, che lo segnala al team di sviluppo.
#   py       → uv pip install --user  → $JHT_HOME/.local (un solo magazzino)
#   node     → npm install -g         → $NPM_CONFIG_PREFIX (/jht_home/.npm-global)
#   browser  → il binario del browser di Playwright (le sue .so di sistema
#              sono già nell'immagine: `playwright install --with-deps` al build)
# Tutto il resto (binari/lib scaricati a mano) va sotto $JHT_DEPS_PREFIX
# (/opt/jht-deps, già in PATH+LD_LIBRARY_PATH) — vedi `jht-install prefix`.
#
# Uso:
#   jht-install apt <pkg...>            # rifiutato: spiega dove va il pacchetto
#   jht-install py  <pkg...>            # es: jht-install py faster-whisper
#   jht-install node <pkg...>           # es: jht-install node @playwright/test
#   jht-install browser [chromium]      # ripara/installa il browser + le sue .so
#   jht-install prefix                  # stampa il prefisso globale per install manuali
#   jht-install help
#
# Filosofia (direttiva utente): libertà > restrizione. Questo wrapper NON
# limita cosa si installa — standardizza DOVE finisce. Da fonti ufficiali.

set -eu

PREFIX="${JHT_DEPS_PREFIX:-/opt/jht-deps}"

usage() {
  sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
}

die() { echo "jht-install: $*" >&2; exit 1; }

lane="${1:-help}"
shift || true

# La CLI del provider (codex, claude, kimi) fa parte dell'IMMAGINE: nessun agente la aggiorna, la installa o la
# sostituisce (JHT-T195). Un pacchetto che e' una di quelle CLI si rifiuta in ogni corsia, con lo stesso exit 3
# di `apt` («non si fa a runtime»): una versione vecchia o rotta si segnala al Capitano, non si tocca.
refuse_provider_cli() {
  local arg name
  for arg in "$@"; do
    name="${arg#@}"                # @openai/codex@0.1 -> openai/codex@0.1
    name="${name%%@*}"             # versione fuori
    name="${name%%==*}"; name="${name%%>=*}"; name="${name%%<=*}"; name="${name%%~=*}"; name="${name%%[*}"
    name=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')
    case "$name" in
      openai/codex|codex|anthropic-ai/claude-code|claude-code|kimi-cli|kimi|moonshotai/kimi-cli)
        echo "jht-install: '$arg' is the provider's CLI, part of the image: nobody in the team updates, installs or replaces it." >&2
        echo "  An old or broken version is reported to the Captain (and the user), not touched." >&2
        exit 3
        ;;
    esac
  done
}
case "$lane" in
  py|python|node|npm) refuse_provider_cli "$@" ;;
esac

case "$lane" in
  apt)
    # Niente sudo nel container: la shell di un agente non diventa root.
    # Exit 3 = «non si fa a runtime», distinto da un install fallito (1).
    echo "jht-install: system packages are not installed at runtime (no sudo in the container)." >&2
    echo "  Needed: ${*:-<pkg>}. Ask the Captain to report it to the development team: it goes into the image." >&2
    echo "  A Python library: jht-install py <pkg>. A standalone binary: build or unpack it under \$(jht-install prefix)." >&2
    exit 3
    ;;
  py|python)
    [ "$#" -gt 0 ] || die "uso: jht-install py <pkg...>"
    # Standard team-rule: uv pip install --user (mai sudo pip). Fallback a
    # pip3 --user se uv non è presente.
    if command -v uv >/dev/null 2>&1; then
      uv pip install --user "$@" || die "uv pip install fallito per: $*"
    else
      pip3 install --user "$@" || die "pip install fallito per: $*"
    fi
    ;;
  node|npm)
    [ "$#" -gt 0 ] || die "uso: jht-install node <pkg...>"
    # -g rispetta NPM_CONFIG_PREFIX (/jht_home/.npm-global), su bind-mount.
    npm install -g "$@" || die "npm install -g fallito per: $*"
    ;;
  browser|playwright)
    target="${1:-chromium}"
    # Binario nel prefisso baked (jht-owned, no root). Le .so di sistema
    # (il caso libatk) sono nell'immagine dal build (`--with-deps` e la lista
    # esplicita nel Dockerfile): qui non c'è root per installarle.
    playwright install --only-shell "$target" || die "playwright install (binario) fallito"
    ;;
  prefix)
    echo "$PREFIX"
    echo "  bin/ è in PATH, lib/ è in LD_LIBRARY_PATH — installa qui ciò che non ha una lane (es. ./configure --prefix=$PREFIX)" >&2
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    die "lane sconosciuta: '$lane' (usa: apt|py|node|browser|prefix|help)"
    ;;
esac
