#!/usr/bin/env bash
# jht-throttle — SHIM di compatibilità sul motore dei throttle.
#
# ⚠️ Deprecato: il comando nuovo è `throttle <tuo-nome>`, che ritorna subito e
# lascia la sveglia al motore. Questo shim esiste per i prompt e le skill che
# chiamano ancora `jht-throttle`, e verrà ritirato quando quei testi migrano.
#
# ## Cosa è cambiato sotto
#
# Prima: questo script forkava un figlio detached che dormiva N secondi, e il
# parent bloccava. Se il parent moriva col timeout della tool call il figlio
# moriva con lui e **nessuno svegliava l'agente** — il 2026-07-30 sono stati
# 2h15m di stallo con la sessione classificata `idle` = sana.
#
# Ora: il TIMER è del motore (`shared/skills/throttle_engine.py`, daemon avviato
# da pid1, non figlio di nessuna shell di agente). Questo script:
#
#   1. registra la pausa nel motore (che applica floor + ladder + deroga);
#   2. blocca in chunk da 15s finché la scadenza non passa — così la semantica
#      che i prompt attuali si aspettano («jht-throttle ti ferma») non cambia;
#   3. all'uscita fa l'ack, che chiude il flag e disarma la sveglia.
#
# Il punto è il passo 3 mancato: se il parent viene killato a metà, l'ack non
# arriva, il timer resta armato SUL DISCO DEL MOTORE e la sveglia arriva
# comunque. Il blocco qui è diventato una comodità, non il meccanismo.
#
# ## Uso (invariato)
#
#   jht-throttle --agent <name> [--reason "..."]            # legge la config
#   jht-throttle <seconds> --agent <name> [--reason "..."]  # richiesta esplicita
#
# ## Exit codes
#
#   0 → pausa completata (o durata 0: no-op)
#   1 → argomenti invalidi / motore non trovato

set -eu

AGENT=""
SECONDS_EXPLICIT=""
REASON=""

while [ $# -gt 0 ]; do
  case "${1:-}" in
    --agent)  AGENT="${2:-}"; shift 2 ;;
    --reason) REASON="${2:-}"; shift 2 ;;
    -h|--help)
      cat <<'HLP'
Usage: jht-throttle [seconds] --agent <name> [--reason "..."]
DEPRECATO — usa `throttle <agent>` (ritorno immediato, il motore ti sveglia).
HLP
      exit 0
      ;;
    *)
      if [ -z "$SECONDS_EXPLICIT" ] && echo "$1" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then
        SECONDS_EXPLICIT="$1"
      fi
      shift
      ;;
  esac
done

if [ -z "$AGENT" ]; then
  echo "error: --agent <name> required" >&2
  exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENGINE="/app/shared/skills/throttle_engine.py"
[ -f "$ENGINE" ] || ENGINE="${SCRIPT_DIR}/../../shared/skills/throttle_engine.py"
if [ ! -f "$ENGINE" ]; then
  echo "error: throttle_engine.py non trovato" >&2
  exit 1
fi

REG_ARGS=( "$ENGINE" register "$AGENT" )
if [ -n "$SECONDS_EXPLICIT" ]; then
  REG_ARGS+=( "$(printf '%.0f' "$SECONDS_EXPLICIT")" )
fi
[ -n "$REASON" ] && REG_ARGS+=( --reason "$REASON" )
REG_ARGS+=( --print until )

UNTIL="$(python3 "${REG_ARGS[@]}" || true)"

# Durata 0 (core interattivo, o config a 0 in deroga): nessuna pausa, nessuna
# sveglia da attendere. Il fast path resta un no-op come prima.
if [ -z "$UNTIL" ]; then
  exit 0
fi

# ── Blocco in chunk da 15s ────────────────────────────────────────────────
# 15s è sotto qualsiasi default provider (Kimi 60s, Codex 30s, Claude 120s), ma
# non è più questo a rendere la pausa affidabile: se veniamo uccisi qui il
# motore sveglia l'agente alla scadenza. Nessun trap di cleanup — cancellare il
# flag all'uscita è precisamente ciò che faceva perdere i throttle.
while :; do
  NOW=$(date '+%s')
  if [ "$NOW" -ge "$UNTIL" ]; then break; fi
  REMAINING=$(( UNTIL - NOW ))
  CHUNK=15
  if [ "$REMAINING" -lt "$CHUNK" ]; then CHUNK="$REMAINING"; fi
  sleep "$CHUNK"
done

# Abbiamo atteso per intero: firmiamo noi il risveglio, così il motore non manda
# una sveglia a un agente che è già ripartito.
python3 "$ENGINE" ack "$AGENT" >/dev/null 2>&1 || true
exit 0
