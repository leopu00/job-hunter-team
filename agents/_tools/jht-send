#!/usr/bin/env python3
"""
jht-send — scrive un messaggio da un agente alla chat web dell'utente.

Usage:
    jht-send "Testo del messaggio"
    jht-send --agent alfa "Testo per un altro agente"
    jht-send --role assistant "..."   # default: assistant
    jht-send --kind blocked "..."     # urgent | blocked | completed | info (default)
    jht-send - <<'TXT'                # the text on stdin: every $ stays as written
    Plus — $20/month; Pro — $100/month
    TXT

A `$` in the text: between double quotes the shell reads `$1` and `$2` as its own
arguments and replaces them with nothing BEFORE this tool starts ("$20" reaches the
user as "0"), and nothing here can bring the digits back. Use single quotes, or "-"
with a heredoc whose delimiter is quoted (<<'TXT'): the text then comes from stdin.

Perché esiste:
    In passato gli agenti scrivevano su chat.jsonl con costrutti bash fragili
    ('echo ... $(date)' o heredoc 'EOF'), finendo per produrre JSON invalido
    e messaggi che non arrivavano al frontend. Questo wrapper centralizza la
    logica: una sola chiamata, niente quoting hell, timestamp numerico
    garantito, validazione post-scrittura.

Dove vive il file chat:
    $JHT_AGENT_DIR/chat.jsonl — se la variabile è settata (caso normale
    quando l'agente gira in tmux lanciato da start-agent.sh).
    Altrimenti ricostruito da --agent + $JHT_HOME/agents/<id>/chat.jsonl.
"""
import argparse
import json
import os
import pathlib
import sys
import time


ESCAPES = {"n": "\n", "t": "\t", "r": "", "\\": "\\"}

# Il tipo del messaggio, scelto da chi lo scrive. Lista chiusa: «info» è il caso
# normale e non si scrive nella riga. Le domande NON sono un tipo: una domanda
# con scelte passa da `jht-notify-user --option`, che sa mostrarle all'utente.
KINDS = ("urgent", "blocked", "completed", "info")
DEFAULT_KIND = "info"

# Tetto del testo (byte UTF-8): `agent_chat.py read` salta in silenzio le righe oltre
# MAX_LINE, quindi un messaggio piu' lungo non comparirebbe mai nell'app. Oltre il
# tetto non si scrive il testo: si scrive una riga di sistema con un codice chiuso e un
# testo fisso (mai il contenuto del messaggio), e si esce con un errore.
MAX_TEXT_BYTES = 16 * 1024
TOO_LONG_CODE = "message_too_long"
TOO_LONG_TEXT = "The agent's message was too long and was not delivered."


def unescape(text: str) -> str:
    """Rimette gli a capo veri al posto degli escape letterali.

    Gli agenti scrivono `jht-send "riga1\\nriga2"`: dentro i doppi apici la
    shell NON tocca la sequenza, quindi qui arrivano i due caratteri
    backslash+n e json.dumps li persiste come "\\\\n". Il frontend mostrava
    "\\n" in mezzo alla frase invece di andare a capo (chat dell'Assistente,
    24/07). `\\\\n` resta un backslash letterale seguito da n.
    """
    out: list[str] = []
    i = 0
    while i < len(text):
        if text[i] == "\\" and i + 1 < len(text) and text[i + 1] in ESCAPES:
            out.append(ESCAPES[text[i + 1]])
            i += 2
            continue
        out.append(text[i])
        i += 1
    return "".join(out)


def resolve_chat_file(agent_id: str | None) -> pathlib.Path:
    if agent_id:
        jht_home = os.environ.get("JHT_HOME") or str(pathlib.Path.home() / ".jht")
        return pathlib.Path(jht_home) / "agents" / agent_id / "chat.jsonl"
    agent_dir = os.environ.get("JHT_AGENT_DIR")
    if agent_dir:
        return pathlib.Path(agent_dir) / "chat.jsonl"
    # Fallback: cwd (l'agente di solito ha cwd = sua dir)
    return pathlib.Path.cwd() / "chat.jsonl"


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Invia un messaggio a chat.jsonl dell'agente (visibile nella chat web).",
    )
    parser.add_argument(
        "message",
        help=(
            "Testo del messaggio (quotalo). Con un `$` nel testo: apici singoli, "
            "oppure `-` per leggerlo da stdin (heredoc <<'TXT')."
        ),
    )
    parser.add_argument(
        "--agent",
        help="ID agente (default: deduce da $JHT_AGENT_DIR o cwd). Es: assistente, alfa.",
    )
    parser.add_argument(
        "--role",
        default="assistant",
        choices=["assistant", "system"],
        help="Ruolo del messaggio (default: assistant).",
    )
    parser.add_argument(
        "--raw",
        action="store_true",
        help="Non interpretare \\n / \\t nel messaggio (testo passato alla lettera).",
    )
    parser.add_argument(
        "--partial",
        action="store_true",
        help=(
            "Marca il messaggio come checkpoint intermedio (done=False). "
            "Il frontend continua a mostrare i 3 puntini di 'sto lavorando'. "
            "Omettilo sull'ultimo messaggio del turno per chiudere lo stato busy."
        ),
    )
    parser.add_argument(
        "--kind",
        default=DEFAULT_KIND,
        help=(
            "Kind of the message: urgent (the user is needed now), blocked (you are stuck), "
            "completed (a finished piece of work), info (anything else, default). "
            "A question is NOT a kind: use jht-notify-user --option. "
            "You declare the kind and the tool writes it as given, without checking it. "
            "Only for the assistant's final messages: not with --partial nor with --role system."
        ),
    )
    args = parser.parse_args()

    if args.message == "-":
        # The text from stdin: a quoted heredoc leaves every `$` alone, which no argument can promise.
        args.message = sys.stdin.read().removesuffix("\n")
        if not args.message.strip():
            print("jht-send: the text on stdin is empty: nothing was written.", file=sys.stderr)
            return 2
        lines = args.message.rstrip().splitlines()
        if lines and lines[-1].strip() == "TXT":
            # an indented closing `TXT`: the heredoc never closed and the shell passed on the delimiter line too
            print(
                "jht-send: the text ends with a `TXT` line: the closing line of the heredoc was indented, so it never closed. "
                "Nothing was written. Put `TXT` in the first column, alone on its line.",
                file=sys.stderr,
            )
            return 2

    if args.kind not in KINDS:
        print(
            f"jht-send: --kind {args.kind!r} non ammesso (valori: {', '.join(KINDS)}). "
            "Le domande con scelte passano da jht-notify-user --option.",
            file=sys.stderr,
        )
        return 2
    if args.kind != DEFAULT_KIND and (args.role != "assistant" or args.partial):
        print(
            f"jht-send: --kind {args.kind} is only for a final message of the assistant: "
            "not with --partial nor with --role system. Nothing was written.",
            file=sys.stderr,
        )
        return 2

    chat_file = resolve_chat_file(args.agent)
    chat_file.parent.mkdir(parents=True, exist_ok=True)

    # `done` = True  → messaggio finale di turno, spegni i puntini
    # `done` = False → checkpoint intermedio, tieni i puntini accesi
    message = args.message if args.raw else unescape(args.message)
    if len(message.encode("utf-8")) > MAX_TEXT_BYTES:
        notice = {
            "role": "system",
            "text": TOO_LONG_TEXT,
            "code": TOO_LONG_CODE,
            "ts": time.time(),
            "done": True,
        }
        with chat_file.open("a", encoding="utf-8") as f:
            f.write(json.dumps(notice, ensure_ascii=False) + "\n")
        print(
            f"jht-send: the text is over {MAX_TEXT_BYTES} bytes: it was not written. "
            "Shorten it or split it into several messages.",
            file=sys.stderr,
        )
        return 2
    entry = {
        "role": args.role,
        "text": message,
        "ts": time.time(),
        "done": not args.partial,
    }
    if args.kind != DEFAULT_KIND:
        entry["kind"] = args.kind
    line = json.dumps(entry, ensure_ascii=False) + "\n"
    with chat_file.open("a", encoding="utf-8") as f:
        f.write(line)

    # Verifica post-scrittura: l'ultima riga deve essere JSON parsabile.
    try:
        raw = chat_file.read_text(encoding="utf-8").rstrip("\n")
        last = raw.split("\n")[-1] if raw else ""
        json.loads(last)
    except Exception as err:  # pragma: no cover
        print(f"jht-send: last line not parsable ({err}) — file corrupted", file=sys.stderr)
        return 1

    print(
        f"jht-send: sent {len(message)} chars as {args.role} to {chat_file}",
        file=sys.stderr,
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
