# Skills the Scout consumes from agents/_skills/.
# One name per line. Lines starting with `#` and blank lines are ignored.
# The launcher (start-agent.sh) reads this file at boot and copies the
# listed skills into the agent's ~/.claude/skills/ runtime workspace.

# Inter-agent (peer Scouts, Analisti, Capitano)
tmux-send

# DB access (dedup, INSERT, dup recovery)
db-query
db-insert
db-update

# Throttle (cooldown loop, freeze)
throttle
# Wake-up ack: first command after every throttle pause. Without it the
# flag stays on NOTIFIED and the watchdog escalates on a healthy agent.
throttle-ack

# Resilience ladder (SC-08): su resume/batch con tool rotto → retry/ripara/alt/OPEN_UNVERIFIED,
# mai stop silenzioso (no falso new=0).
resilience

# User feedback signal (like/dislike/hide/star from web dashboard)
feedback-query

# Scout-only operative skills
scout-coord
circles-and-sources
position-insert

# Email sourcing (day-start): poll the dedicated team inbox, any platform
email-monitor

# Stack di accesso web (F-2) — il Capitano lo NOMINA nei suoi ordini
# (capitano.md: "uno Scout ne fa il poll, skill `scout-web-access`"), quindi
# deve stare nel workspace dello Scout, non del Capitano: anti-bot robust
# scrape, sessione LinkedIn, poll IMAP, claim workspace multi-Scout, freshness.
scout-web-access

# User chat (game / desktop app). A [CHAT] landing in your pane is answered
# with ONE short jht-send and then you go straight back to work: the reply
# costs a full turn of THIS agent's model, and orders still come from the
# Capitano, never from the chat.
chat-worker

# Measure of the searches: how many candidates each pass returns and where each one ends
# (closed vocabulary, nothing of the profile). TUI team only for now.
scout-pass-log

# Languages first, fetch later: countries and queries from the profile's languages, and the cut by language
# on the list's title and snippet before the full ad is fetched. TUI team only for now.
scout-language-gate

# Where to search first: the core national portals of the profile's languages before any minor source, and how much
# of that plan is done (`next` names the portal and the kind of query). TUI team only for now.
scout-coverage
