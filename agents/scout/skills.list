# Skills the Scout consumes from agents/_skills/.
# One name per line. Lines starting with `#` and blank lines are ignored.
# The launcher (start-agent.sh) reads this file at boot and copies the
# listed skills into the agent's ~/.claude/skills/ runtime workspace.

# Inter-agent (peer Scouts, Analisti, Capitano)
tmux-send

# DB access (dedup, INSERT, dup recovery)
db-query
db-insert
db-update

# Throttle (cooldown loop, freeze)
throttle

# Resilience ladder (SC-08): su resume/batch con tool rotto → retry/ripara/alt/OPEN_UNVERIFIED,
# mai stop silenzioso (no falso new=0).
resilience

# User feedback signal (like/dislike/hide/star from web dashboard)
feedback-query

# Scout-only operative skills
scout-coord
circles-and-sources
position-insert

# Email sourcing (day-start): poll the dedicated team inbox, any platform
email-monitor

# User chat (game / desktop app). A [CHAT] landing in your pane is answered
# with ONE short jht-send and then you go straight back to work: the reply
# costs a full turn of THIS agent's model, and orders still come from the
# Capitano, never from the chat.
chat-worker
