# Skills the Scrittore consumes from agents/_skills/.
# One name per line. Lines starting with `#` and blank lines are ignored.
# The launcher (start-agent.sh) reads this file at boot and copies the
# listed skills into the agent's ~/.claude/skills/ runtime workspace.

# Inter-agent (peer Scrittori, Critico, Capitano)
tmux-send

# DB access (queue + claim + application UPSERT)
db-query
db-insert
db-update

# Throttle (cooldown, freeze, polling during critic-loop)
throttle
# Wake-up ack: first command after every throttle pause. Without it the
# flag stays on NOTIFIED and the watchdog escalates on a healthy agent.
throttle-ack

# Scrittore-only operative skills
application-flow
cv-structure
critic-loop

# User chat (game / desktop app). A [CHAT] landing in your pane is answered
# with ONE short jht-send and then you go straight back to work: the reply
# costs a full turn of THIS agent's model, and orders still come from the
# Capitano, never from the chat.
chat-worker
