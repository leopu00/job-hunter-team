# Skills the Assistente consumes from agents/_skills/.
# One name per line. Lines starting with `#` and blank lines are ignored.
# The launcher (start-agent.sh) reads this file at boot and copies the
# listed skills into the agent's ~/.claude/skills/ runtime workspace.

# User communication (web UI)
chat-web
game-reply-options

# User communication (Telegram outbound — phone-side interface)
telegram-send

# Notifiche utente con fallback Telegram -> dashboard web (domande proattive, alert profilo)
notify-user

# Pickup risposte utente arrivate via dashboard web (marker prompt-injection)
user-reply-check

# Inter-agent (bridge to the Capitano when needed)
tmux-send

# Emergency: spawn fresh DOTTORE quando l'utente chiede via Telegram
# "fai partire il dottore" / "dottora" / "controlla il team". Tra i
# cicli auto-watchdog (2h) la sessione DOTTORE è bash residua: scriverle
# è inutile, va spawnata ex-novo. Post-mortem 2026-05-18-capitano-zombie-night.
spawn-doctor

# Profile maintenance — the Assistente's daily loop
profile-yaml
# profile-yaml/SKILL.md linka `../profile-schema/SKILL.md` nel contesto di una
# validazione obbligatoria: start-agent.sh copia le skill PIATTE in
# ~/.claude/skills/<nome>, quindi il `../` risolve solo se profile-schema e'
# installata accanto. L'Assistente scrive candidate_profile.yml, che tutto il
# team consuma: senza lo schema canonico il formato se lo inventa.
profile-schema
profile-summaries
onboarding-flow

# Read-only DB lookups (e.g. show the user the state of their applications
# if they ask). The Assistente never writes to the DB.
db-query

# rate-budget: read-only `plan` mode only — never `live`.
# Useful only if the user asks "how is the team doing?" out of curiosity.
rate-budget
