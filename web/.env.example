# Job Hunter Team — Web App — variabili d'ambiente
#
# Copia questo file in .env.local e compila i valori:
#   cp web/.env.example web/.env.local
#
# Ottieni le credenziali dal tuo progetto Supabase:
#   https://app.supabase.com → Settings → API

# ── Supabase (obbligatorio) ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Solo server-side. Non usare nel browser.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Google Sheets (opzionale) ───────────────────────────────────────────────
# ID del foglio Google per l'esportazione candidature
# Trova l'ID nell'URL: docs.google.com/spreadsheets/d/<ID>/edit
NEXT_PUBLIC_GOOGLE_SHEETS_ID=

# ── AI Assistant Web Chat (opzionale) ───────────────────────────────────────
# Solo server-side. Attiva il chatbot floating e la pagina /ai-assistant.
OPENAI_API_KEY=
JHT_AI_ASSISTANT_MODEL=gpt-4o-mini

# ── Segnalazioni in-app (/api/feedback) ─────────────────────────────────────
# Dove finiscono i report che arrivano dalla sezione "Segnala un problema"
# dell'app desktop. Senza nessuna destinazione configurata l'endpoint
# risponde 503 e il client dice all'utente che la copia è rimasta in locale:
# meglio un fallimento onesto che una segnalazione che sparisce.
#
# Destinazione PRINCIPALE: la casella del progetto. Chi segnala un crash non
# ha un account GitHub — qui la sua segnalazione diventa una mail normale, con
# Reply-To sul suo indirizzo, così rispondere è un click.
# La chiave Resend va creata con permesso "Sending access" sul dominio.
RESEND_API_KEY=
JHT_FEEDBACK_TO=support@jobhunterteam.ai
JHT_FEEDBACK_FROM=Segnalazioni JHT <support@jobhunterteam.ai>

# Destinazione secondaria: apre anche la issue per il triage interno.
# Token con permesso `issues: write` sul repo, e NIENT'ALTRO. Se qualcuno lo
# estrae dalle env di Vercel, il danno massimo è che apra delle issue.
JHT_FEEDBACK_GITHUB_TOKEN=
JHT_FEEDBACK_REPO=leopu00/job-hunter-team
# Canale secondario (Slack/Discord/automazione). Riceve anche il contatto
# dell'utente, che nella issue pubblica non compare mai.
JHT_FEEDBACK_WEBHOOK_URL=
# Mostrato all'utente quando nessun canale risponde.
JHT_SUPPORT_EMAIL=support@jobhunterteam.ai
